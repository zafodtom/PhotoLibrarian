<UserControl
    x:Class="PhotoLibrarian.Views.TopRibbon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Icon-above-label command button, the Photo Gallery ribbon idiom. -->
        <Style x:Key="RibbonCommandStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="RibbonIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RibbonCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RibbonSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="8,12" />
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid Padding="8,0" MinHeight="64" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ===== Viewer mode (default) ===== -->
            <StackPanel x:Name="ViewerTools" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="MakeCopyButton" Visibility="Collapsed" Click="OnMakeCopyClick"
                        Style="{StaticResource RibbonCommandStyle}"
                        AutomationProperties.AutomationId="RibbonMakeCopy"
                        AutomationProperties.Name="Make a copy"
                        ToolTipService.ToolTip="Create a separate copy of this photo to edit">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE8C8;" Style="{StaticResource RibbonIconStyle}" />
                        <TextBlock Text="Make a copy" Style="{StaticResource RibbonCaptionStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="CropButton" Click="OnCropClick"
                        Style="{StaticResource RibbonCommandStyle}"
                        AutomationProperties.AutomationId="RibbonCrop"
                        AutomationProperties.Name="Crop"
                        ToolTipService.ToolTip="Crop this photo">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE7A8;" Style="{StaticResource RibbonIconStyle}" />
                        <TextBlock Text="Crop" Style="{StaticResource RibbonCaptionStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="StraightenButton" Visibility="Collapsed" Click="OnStraightenClick"
                        Style="{StaticResource RibbonCommandStyle}"
                        AutomationProperties.AutomationId="RibbonStraighten"
                        AutomationProperties.Name="Straighten"
                        ToolTipService.ToolTip="Straighten this photo">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE7AD;" Style="{StaticResource RibbonIconStyle}" />
                        <TextBlock Text="Straighten" Style="{StaticResource RibbonCaptionStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="AdjustButton" Visibility="Collapsed" Click="OnAdjustClick"
                        Style="{StaticResource RibbonCommandStyle}"
                        AutomationProperties.AutomationId="RibbonAdjust"
                        AutomationProperties.Name="Adjust"
                        ToolTipService.ToolTip="Adjust exposure, colour and detail">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE793;" Style="{StaticResource RibbonIconStyle}" />
                        <TextBlock Text="Adjust" Style="{StaticResource RibbonCaptionStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="RedEyeButton" Visibility="Collapsed" Click="OnRedEyeClick"
                        Style="{StaticResource RibbonCommandStyle}"
                        AutomationProperties.AutomationId="RibbonRedEye"
                        AutomationProperties.Name="Red eye"
                        ToolTipService.ToolTip="Remove red eye from this photo">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE77B;" Style="{StaticResource RibbonIconStyle}" />
                        <TextBlock Text="Red eye" Style="{StaticResource RibbonCaptionStyle}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ===== Crop sub-mode (replaces ViewerTools when crop is active) ===== -->
            <StackPanel x:Name="CropTools" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="4,0">
                    <FontIcon Glyph="&#xE7A8;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="Crop" VerticalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                </StackPanel>

                <Rectangle Style="{StaticResource RibbonSeparatorStyle}" />

                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock Text="Proportion" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="AspectCombo"
                              AutomationProperties.AutomationId="RibbonCropAspect"
                              AutomationProperties.Name="Crop proportion"
                              SelectionChanged="OnAspectChanged"
                              MinWidth="152">
                        <ComboBoxItem Content="Original" Tag="Original" />
                        <ComboBoxItem Content="Free" Tag="Free" IsSelected="True" />
                        <ComboBoxItem Content="Square (1:1)" Tag="Square" />
                        <ComboBoxItem Content="4:3" Tag="Landscape4x3" />
                        <ComboBoxItem Content="3:2 (35mm)" Tag="Landscape3x2" />
                        <ComboBoxItem Content="16:9" Tag="Landscape16x9" />
                    </ComboBox>
                </StackPanel>

                <Rectangle Style="{StaticResource RibbonSeparatorStyle}" />

                <Button x:Name="ApplyCropButton" Click="OnApplyCropClick"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="16,6" VerticalAlignment="Center" Margin="0,0,8,0"
                        AutomationProperties.AutomationId="RibbonCropApply"
                        AutomationProperties.Name="Apply crop"
                        ToolTipService.ToolTip="Apply the crop to this photo (Enter)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" />
                        <TextBlock Text="Apply" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelCropButton" Click="OnCancelCropClick"
                        Padding="16,6" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="RibbonCropCancel"
                        AutomationProperties.Name="Cancel crop"
                        ToolTipService.ToolTip="Discard the crop (Esc)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                        <TextBlock Text="Cancel" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ===== Straighten sub-mode ===== -->
            <StackPanel x:Name="StraightenTools" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="4,0">
                    <FontIcon Glyph="&#xE7AD;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="Straighten" VerticalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                </StackPanel>

                <Rectangle Style="{StaticResource RibbonSeparatorStyle}" />

                <Button x:Name="ApplyStraightenButton" Click="OnApplyStraightenClick"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="16,6" VerticalAlignment="Center" Margin="0,0,8,0"
                        AutomationProperties.AutomationId="RibbonStraightenApply"
                        AutomationProperties.Name="Apply straighten"
                        ToolTipService.ToolTip="Apply straighten to this photo (Enter)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" />
                        <TextBlock Text="Apply" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelStraightenButton" Click="OnCancelStraightenClick"
                        Padding="16,6" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="RibbonStraightenCancel"
                        AutomationProperties.Name="Cancel straighten"
                        ToolTipService.ToolTip="Discard straighten (Esc)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                        <TextBlock Text="Cancel" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Centre: current file name plus a mode hint -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                <TextBlock x:Name="ContextLabel"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Text="" />
                <TextBlock x:Name="ContextSubLabel"
                           HorizontalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed"
                           Text="" />
            </StackPanel>

            <!-- Right-side actions -->
            <Button x:Name="CloseViewerButton" Grid.Column="2"
                    Click="OnCloseViewerClick"
                    Style="{StaticResource RibbonCommandStyle}"
                    AutomationProperties.AutomationId="RibbonCloseViewer"
                    AutomationProperties.Name="Back to grid"
                    ToolTipService.ToolTip="Back to grid (Esc)">
                <StackPanel Spacing="4">
                    <FontIcon Glyph="&#xE71D;" Style="{StaticResource RibbonIconStyle}" />
                    <TextBlock Text="Close" Style="{StaticResource RibbonCaptionStyle}" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
