<UserControl
    x:Class="PhotoLibrarian.Views.ImageViewerOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhotoLibrarian.Views"
    Background="Black"
    IsTabStop="True">

    <Grid x:Name="RootGrid" Background="Black">
        <Grid.Resources>
            <Flyout x:Name="ManualFaceTagFlyout"
                    Placement="Bottom"
                    Closed="OnManualFaceTagFlyoutClosed">
                <StackPanel Width="280" Spacing="12">
                    <TextBlock Text="Tag this face"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="ManualFaceRecentPeopleLabel"
                               Text="Recent"
                               Visibility="Collapsed"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <StackPanel x:Name="ManualFaceRecentPeoplePanel"
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="Collapsed" />
                    <ComboBox x:Name="ManualFacePersonCombo"
                              AutomationProperties.AutomationId="ManualFacePerson"
                              AutomationProperties.Name="Choose an existing person"
                              DisplayMemberPath="Name"
                              PlaceholderText="Choose an existing person" />
                    <TextBox x:Name="ManualFaceNewPersonBox"
                             AutomationProperties.AutomationId="ManualFaceNewPerson"
                             AutomationProperties.Name="Create a new person"
                             Header="Or create a new person"
                             PlaceholderText="Person name" />
                    <TextBlock Text="Choose an existing person or enter a new name."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Content="Cancel"
                                Click="OnCancelManualFaceTagClick" />
                        <Button x:Name="SaveManualFaceTagButton"
                                AutomationProperties.AutomationId="SaveManualFaceTag"
                                AutomationProperties.Name="Save people tag"
                                Content="Save"
                                Click="OnSaveManualFaceTagClick"
                                Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Flyout>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <!-- The top bar takes its own row rather than floating over the image, so the
                 viewport used for best-fit is the space the image actually gets. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Top bar -->
        <Grid x:Name="TopBar" Grid.Row="0" Grid.ColumnSpan="2" Padding="12,8"
              Background="#CC000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="TitleText" Foreground="White"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="IndexText" Foreground="#99FFFFFF"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ManualFaceTagHelpText"
                           Text="Draw a box around the face, then choose or add a person."
                           Foreground="White"
                           Visibility="Collapsed"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button x:Name="ZoomOutButton"
                        AutomationProperties.AutomationId="ViewerZoomOut"
                        AutomationProperties.Name="Zoom out"
                        Click="OnZoomOut" ToolTipService.ToolTip="Zoom out" Padding="8">
                    <FontIcon Glyph="&#xE71F;" FontSize="14" Foreground="White" />
                </Button>
                <Button x:Name="ZoomFitButton"
                        AutomationProperties.AutomationId="ViewerZoomFit"
                        AutomationProperties.Name="Fit to window"
                        Click="OnZoomFit" ToolTipService.ToolTip="Fit to window" Padding="8">
                    <FontIcon Glyph="&#xE9A6;" FontSize="14" Foreground="White" />
                </Button>
                <Button x:Name="ZoomActualSizeButton"
                        AutomationProperties.AutomationId="ViewerZoomActualSize"
                        AutomationProperties.Name="Actual size 100 percent"
                        Click="OnZoomActualSize"
                        ToolTipService.ToolTip="Actual size (100%)"
                        Padding="8,6">
                    <TextBlock Text="100 %" FontSize="12" Foreground="White" />
                </Button>
                <Button x:Name="ZoomInButton"
                        AutomationProperties.AutomationId="ViewerZoomIn"
                        AutomationProperties.Name="Zoom in"
                        Click="OnZoomIn" ToolTipService.ToolTip="Zoom in" Padding="8">
                    <FontIcon Glyph="&#xE8A3;" FontSize="14" Foreground="White" />
                </Button>
                <Button x:Name="DeleteCurrentButton"
                        AutomationProperties.AutomationId="ViewerDelete"
                        AutomationProperties.Name="Delete current item"
                        Click="OnDeleteCurrent"
                        Padding="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="White" />
                </Button>
                <Button x:Name="CancelManualFaceTaggingButton"
                        AutomationProperties.AutomationId="CancelManualFaceTagging"
                        AutomationProperties.Name="Cancel adding a people tag"
                        Click="OnCancelManualFaceTagging"
                        ToolTipService.ToolTip="Cancel adding a people tag (Escape)"
                        Padding="8"
                        Visibility="Collapsed">
                    <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="White" />
                </Button>
                <Button AutomationProperties.AutomationId="ViewerClose"
                        AutomationProperties.Name="Close viewer"
                        Click="OnClose" ToolTipService.ToolTip="Close (Escape)" Padding="8"
                        Margin="12,0,0,0">
                    <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="White" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Image viewer with zoom/pan -->
        <ScrollViewer x:Name="ImageScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      SizeChanged="ImageScrollViewer_SizeChanged"
                      DoubleTapped="OnViewerDoubleTapped"
                      PointerPressed="ImageScrollViewer_PointerPressed"
                      PointerMoved="ImageScrollViewer_PointerMoved"
                      PointerReleased="ImageScrollViewer_PointerReleased"
                      PointerCanceled="ImageScrollViewer_PointerCanceled">
            <Canvas x:Name="ScrollContent">
                <Grid x:Name="ImageHost">
                    <Image x:Name="FullImage"
                           RenderTransformOrigin="0.5,0.5"
                           Stretch="Uniform">
                        <Image.RenderTransform>
                            <CompositeTransform x:Name="StraightenTransform" />
                        </Image.RenderTransform>
                    </Image>
                    <views:CropOverlay x:Name="CropOverlayView" Visibility="Collapsed" />
                    <Canvas x:Name="FaceHighlightOverlay"
                            Background="Transparent"
                            IsHitTestVisible="False">
                        <Rectangle x:Name="FaceHighlightRectangle"
                                   IsHitTestVisible="False"
                                   Stroke="{ThemeResource SystemFillColorCautionBrush}"
                                   StrokeThickness="3"
                                   Visibility="Collapsed" />
                    </Canvas>
                    <Canvas x:Name="ManualFaceOverlay"
                            AutomationProperties.AutomationId="ManualFaceTagCanvas"
                            AutomationProperties.Name="Draw a box around a face"
                            Background="Transparent"
                            PointerPressed="OnManualFacePointerPressed"
                            PointerMoved="OnManualFacePointerMoved"
                            PointerReleased="OnManualFacePointerReleased"
                            PointerCanceled="OnManualFacePointerCanceled"
                            Visibility="Collapsed">
                        <Rectangle x:Name="ManualFaceRectangle"
                                   IsHitTestVisible="False"
                                   Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                   StrokeThickness="2"
                                   Visibility="Collapsed" />
                    </Canvas>
                    <Canvas x:Name="RedEyeOverlay"
                            AutomationProperties.AutomationId="RedEyeSelectionCanvas"
                            AutomationProperties.Name="Draw a box around the eyes"
                            Background="Transparent"
                            PointerPressed="OnRedEyePointerPressed"
                            PointerMoved="OnRedEyePointerMoved"
                            PointerReleased="OnRedEyePointerReleased"
                            PointerCanceled="OnRedEyePointerCanceled"
                            Visibility="Collapsed">
                        <Rectangle x:Name="RedEyeRectangle"
                                   IsHitTestVisible="False"
                                   Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                   StrokeThickness="2"
                                   Visibility="Collapsed" />
                    </Canvas>
                    <Grid x:Name="StraightenGrid"
                          IsHitTestVisible="False"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="1"
                                   Grid.RowSpan="3"
                                   HorizontalAlignment="Left"
                                   Width="1"
                                   Fill="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        <Rectangle Grid.Column="2"
                                   Grid.RowSpan="3"
                                   HorizontalAlignment="Left"
                                   Width="1"
                                   Fill="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        <Rectangle Grid.Row="1"
                                   Grid.ColumnSpan="3"
                                   VerticalAlignment="Top"
                                   Height="1"
                                   Fill="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        <Rectangle Grid.Row="2"
                                   Grid.ColumnSpan="3"
                                   VerticalAlignment="Top"
                                   Height="1"
                                   Fill="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                    </Grid>
                    <Canvas x:Name="StraightenGuideOverlay"
                            AutomationProperties.AutomationId="StraightenGuide"
                            AutomationProperties.Name="Drag along the horizon to straighten"
                            Background="Transparent"
                            PointerPressed="OnStraightenGuidePointerPressed"
                            PointerMoved="OnStraightenGuidePointerMoved"
                            PointerReleased="OnStraightenGuidePointerReleased"
                            PointerCanceled="OnStraightenGuidePointerCanceled"
                            Visibility="Collapsed">
                        <Line x:Name="StraightenGuideLine"
                              Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                              StrokeThickness="2"
                              Visibility="Collapsed" />
                    </Canvas>
                </Grid>
            </Canvas>
        </ScrollViewer>

        <!-- Straighten fine-tune panel -->
        <Border x:Name="StraightenPanel"
                Grid.Row="1"
                Grid.Column="1"
                Width="304"
                Padding="20"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <StackPanel Spacing="16">
                <TextBlock Text="Fine-tune"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Drag along the horizon, use Auto, or fine-tune the angle until features align with the grid."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Angle"
                               VerticalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="StraightenAngleText"
                               Grid.Column="1"
                               MinWidth="64"
                               HorizontalTextAlignment="Right"
                               Text="0.0°"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                </Grid>

                <Slider x:Name="StraightenAngleSlider"
                        AutomationProperties.AutomationId="StraightenAngle"
                        AutomationProperties.Name="Straighten angle in degrees"
                        Minimum="-45"
                        Maximum="45"
                        StepFrequency="0.1"
                        SmallChange="0.1"
                        LargeChange="1"
                        ValueChanged="OnStraightenAngleChanged" />

                <Button x:Name="AutoStraightenButton"
                        AutomationProperties.AutomationId="StraightenAuto"
                        AutomationProperties.Name="Automatically detect straightening angle"
                        HorizontalAlignment="Stretch"
                        Click="OnAutoStraightenClick">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8">
                        <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                        <TextBlock Text="Auto detect" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="AutoStraightenStatus"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Auto detects a dominant horizon or vertical line."
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Border>

        <!-- Video player (shown instead of Image for videos) -->
        <MediaPlayerElement x:Name="VideoPlayer"
                            Grid.Row="1"
                            Visibility="Collapsed"
                            DoubleTapped="OnViewerDoubleTapped"
                            AreTransportControlsEnabled="True"
                            AutoPlay="True"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

        <Border x:Name="ZoomPercentBadge"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Padding="8,4"
                Background="#B3000000"
                CornerRadius="4"
                IsHitTestVisible="False">
            <TextBlock x:Name="ZoomPercentText"
                       Foreground="White"
                       FontSize="12"
                       Text="100 %" />
        </Border>

        <!-- Navigation arrows -->
        <Button x:Name="PreviousButton" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left"
                AutomationProperties.AutomationId="ViewerPrevious"
                AutomationProperties.Name="Previous photo"
                Click="OnPrevious" Margin="12" Padding="12"
                Opacity="0.7" ToolTipService.ToolTip="Previous (Left arrow)">
            <FontIcon Glyph="&#xE76B;" FontSize="20" />
        </Button>
        <Button x:Name="NextButton" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                AutomationProperties.AutomationId="ViewerNext"
                AutomationProperties.Name="Next photo"
                Click="OnNext" Margin="12" Padding="12"
                Opacity="0.7" ToolTipService.ToolTip="Next (Right arrow)">
            <FontIcon Glyph="&#xE76C;" FontSize="20" />
        </Button>

    </Grid>
</UserControl>
