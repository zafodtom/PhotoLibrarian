<UserControl
    x:Class="PhotoLibrarian.Views.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid MaxWidth="760">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="24,24,24,16"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Text="Settings" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,0,24,16"
                        Spacing="16">

                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                               Text="Library import" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Import existing tags and metadata into the currently open album. Source databases are opened read-only and are never modified."
                               TextWrapping="Wrap" />

                    <Border Padding="12"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Text="digiKam" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Imports tag hierarchy, tag assignments, and captions from digikam4.db."
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ImportDigiKamButton"
                                        AutomationProperties.AutomationId="ImportDigiKamButton"
                                        Content="Import from digiKam…"
                                        Click="OnImportDigiKam" />
                                <ProgressRing x:Name="DigiKamImportProgressRing"
                                              Width="20"
                                              Height="20"
                                              IsActive="False"
                                              Visibility="Collapsed" />
                            </StackPanel>
                            <ProgressBar x:Name="DigiKamImportProgressBar"
                                         Minimum="0"
                                         Maximum="100"
                                         Visibility="Collapsed" />
                            <TextBlock x:Name="DigiKamImportStatusText"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Padding="12"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Text="Stash" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Imports image tags from stash-go.sqlite or directly from a Stash backup ZIP."
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ImportStashButton"
                                        AutomationProperties.AutomationId="ImportStashButton"
                                        Content="Import from Stash…"
                                        Click="OnImportStash" />
                                <ProgressRing x:Name="StashImportProgressRing"
                                              Width="20"
                                              Height="20"
                                              IsActive="False"
                                              Visibility="Collapsed" />
                            </StackPanel>
                            <ProgressBar x:Name="StashImportProgressBar"
                                         Minimum="0"
                                         Maximum="100"
                                         Visibility="Collapsed" />
                            <TextBlock x:Name="StashImportStatusText"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                               Text="Cache" />
                    <TextBlock x:Name="CacheSizeText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Cache size: calculating…" />
                    <TextBlock x:Name="CachePathText"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               IsTextSelectionEnabled="True"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <Button AutomationProperties.AutomationId="RebuildCacheButton"
                            HorizontalAlignment="Left"
                            Content="Rebuild thumbnail cache"
                            Click="OnRebuildCache" />
                </StackPanel>

                <Border Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                               Text="About" />
                    <TextBlock Text="PhotoLibrarian" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="A local-first portable photo library." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="24,12"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Button AutomationProperties.AutomationId="CloseSettingsButton"
                    HorizontalAlignment="Right"
                    Content="Close"
                    Click="OnClose" />
        </Border>
    </Grid>
</UserControl>
