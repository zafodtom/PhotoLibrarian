<UserControl
    x:Class="PhotoLibrarian.Views.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PhotoLibrarian.Controls">

    <Grid Background="{StaticResource HiTechAppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <!-- Settings global header -->
        <Grid Grid.Row="0"
              Background="{StaticResource HiTechPanelBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="22,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Width="4"
                           Fill="{StaticResource HiTechAccentBrush}" />
                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="SYSTEM // CONFIG"
                               FontFamily="Consolas"
                               FontSize="18"
                               FontWeight="SemiBold"
                               CharacterSpacing="100"
                               Foreground="{StaticResource HiTechTextPrimaryBrush}" />
                    <TextBlock Text="PHOTOLIBRARIAN CONTROL MATRIX"
                               Style="{StaticResource HiTechSystemCaptionStyle}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="2">
                <TextBlock Text="CONFIGURATION CONSOLE"
                           HorizontalAlignment="Center"
                           Style="{StaticResource HiTechPanelHeadingStyle}"
                           FontSize="13" />
                <TextBlock Text="IMPORT / CACHE / SYSTEM"
                           HorizontalAlignment="Center"
                           Style="{StaticResource HiTechTinyLabelStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,22,0">
                <TextBlock Text="ACCESS"
                           HorizontalAlignment="Right"
                           Style="{StaticResource HiTechTinyLabelStyle}" />
                <TextBlock Text="LOCAL ADMIN"
                           HorizontalAlignment="Right"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="{StaticResource HiTechAccentBrush}" />
            </StackPanel>

            <Rectangle Grid.ColumnSpan="3"
                       Height="1"
                       Fill="{StaticResource HiTechAccentMutedBrush}"
                       VerticalAlignment="Bottom" />
            <Rectangle Grid.ColumnSpan="3"
                       Width="110"
                       Height="2"
                       Fill="{StaticResource HiTechAccentBrush}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="22,0,0,-1" />
        </Grid>

        <!-- Settings body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left system map -->
            <Border Grid.Column="0"
                    Background="{StaticResource HiTechPanelBackgroundBrush}"
                    BorderBrush="{StaticResource HiTechBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="8">
                        <TextBlock Text="CONFIG MAP"
                                   Style="{StaticResource HiTechSystemCaptionStyle}" />
                        <Rectangle Height="1"
                                   Fill="{StaticResource HiTechAccentMutedBrush}" />

                        <Button Content="01  IMPORT"
                                Click="OnNavigateImport"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                ToolTipService.ToolTip="External metadata"
                                Style="{StaticResource HiTechRailButtonStyle}" />
                        <Button Content="02  CACHE"
                                Click="OnNavigateCache"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                ToolTipService.ToolTip="Thumbnails and storage"
                                Style="{StaticResource HiTechRailButtonStyle}" />
                        <Button Content="03  ALBUM"
                                Click="OnNavigateAlbum"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                ToolTipService.ToolTip="Conversion and cleanup"
                                Style="{StaticResource HiTechRailButtonStyle}" />
                        <Button Content="04  ABOUT"
                                Click="OnNavigateAbout"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                ToolTipService.ToolTip="Version and updates"
                                Style="{StaticResource HiTechRailButtonStyle}" />
                        
                    </StackPanel>

                    <StackPanel Grid.Row="2" Spacing="5">
                        <TextBlock Text="NODE // LOCAL"
                                   Style="{StaticResource HiTechTinyLabelStyle}" />
                        <Rectangle Width="44"
                                   Height="1"
                                   Fill="{StaticResource HiTechAccentMutedBrush}" />
                        <TextBlock Text="NO CLOUD LINK"
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   Foreground="{StaticResource HiTechTextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main settings modules -->
            <ScrollViewer x:Name="SettingsContentScrollViewer" Grid.Column="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SettingsSectionsStack"
                            Padding="24,18,28,24"
                            Spacing="16"
                            MaxWidth="1050">

                    <!-- Import section -->
                    <Grid x:Name="ImportSectionHeader" Height="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Width="4"
                                   Height="22"
                                   Fill="{StaticResource HiTechAccentBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0">
                            <TextBlock Text="LIBRARY IMPORT"
                                       Style="{StaticResource HiTechPanelHeadingStyle}" />
                            <TextBlock Text="READ-ONLY EXTERNAL METADATA INGEST"
                                       Style="{StaticResource HiTechTinyLabelStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="SEC // 01"
                                   Style="{StaticResource HiTechTinyLabelStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Foreground="{StaticResource HiTechTextSecondaryBrush}"
                               Text="Import existing tags and metadata into the currently open album. Source databases are opened read-only and are never modified."
                               FontFamily="Consolas"
                               FontSize="11"
                               TextWrapping="Wrap" />

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource HiTechModuleStyle}"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DIGIKAM"
                                                   Style="{StaticResource HiTechPanelHeadingStyle}" />
                                        <TextBlock Text="SOURCE / digikam4.db"
                                                   Style="{StaticResource HiTechTinyLabelStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="EXT-A"
                                               Style="{StaticResource HiTechTinyLabelStyle}" />
                                </Grid>
                                <Rectangle Height="1"
                                           Fill="{StaticResource HiTechBorderBrush}" />
                                <TextBlock Foreground="{StaticResource HiTechTextSecondaryBrush}"
                                           Text="Imports tag hierarchy, tag assignments, and captions from digikam4.db."
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10">
                                    <Button x:Name="ImportDigiKamButton"
                                            AutomationProperties.AutomationId="ImportDigiKamButton"
                                            Content="IMPORT DIGIKAM"
                                            Click="OnImportDigiKam"
                                            Style="{StaticResource HiTechPrimaryButtonStyle}" />
                                </StackPanel>
                                <controls:CinematicProgressBar x:Name="DigiKamImportProgressBar"
                                             Minimum="0"
                                             Maximum="100"
                                             Visibility="Collapsed" />
                                <TextBlock x:Name="DigiKamImportStatusText"
                                           Foreground="{StaticResource HiTechTextSecondaryBrush}"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource HiTechModuleStyle}"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="STASH"
                                                   Style="{StaticResource HiTechPanelHeadingStyle}" />
                                        <TextBlock Text="SOURCE / SQLITE OR BACKUP ZIP"
                                                   Style="{StaticResource HiTechTinyLabelStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="EXT-B"
                                               Style="{StaticResource HiTechTinyLabelStyle}" />
                                </Grid>
                                <Rectangle Height="1"
                                           Fill="{StaticResource HiTechBorderBrush}" />
                                <TextBlock Foreground="{StaticResource HiTechTextSecondaryBrush}"
                                           Text="Imports image tags from stash-go.sqlite or directly from a Stash backup ZIP."
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10">
                                    <Button x:Name="ImportStashButton"
                                            AutomationProperties.AutomationId="ImportStashButton"
                                            Content="IMPORT STASH"
                                            Click="OnImportStash"
                                            Style="{StaticResource HiTechPrimaryButtonStyle}" />
                                </StackPanel>
                                <controls:CinematicProgressBar x:Name="StashImportProgressBar"
                                             Minimum="0"
                                             Maximum="100"
                                             Visibility="Collapsed" />
                                <TextBlock x:Name="StashImportStatusText"
                                           Foreground="{StaticResource HiTechTextSecondaryBrush}"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Cache section -->
                    <Grid x:Name="CacheSectionHeader" Height="34" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Width="4"
                                   Height="22"
                                   Fill="{StaticResource HiTechAccentBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0">
                            <TextBlock Text="CACHE CONTROL"
                                       Style="{StaticResource HiTechPanelHeadingStyle}" />
                            <TextBlock Text="PORTABLE THUMBNAIL CACHE (MAX 1 GB)"
                                       Style="{StaticResource HiTechTinyLabelStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="SEC // 02"
                                   Style="{StaticResource HiTechTinyLabelStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource HiTechModuleStyle}"
                            Padding="16">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="CACHE STATUS"
                                           Style="{StaticResource HiTechTinyLabelStyle}" />
                                <TextBlock x:Name="CacheSizeText"
                                           FontFamily="Consolas"
                                           FontSize="16"
                                           Foreground="{StaticResource HiTechAccentBrush}"
                                           Text="Cache size: calculating…" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="LOCATION"
                                           Style="{StaticResource HiTechTinyLabelStyle}" />
                                <TextBlock x:Name="CachePathText"
                                           Foreground="{StaticResource HiTechTextSecondaryBrush}"
                                           IsTextSelectionEnabled="True"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button x:Name="RebuildCacheButton" Grid.Column="2"
                                    AutomationProperties.AutomationId="RebuildCacheButton"
                                    VerticalAlignment="Center"
                                    Content="CLEAR THUMBNAILS"
                                    Click="OnRebuildCache"
                                    Style="{StaticResource HiTechPrimaryButtonStyle}" />
                        </Grid>
                    </Border>

                    <!-- Generate only missing 256px thumbnails for the active album. -->
                    <Border Style="{StaticResource HiTechModuleStyle}" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="THUMBNAIL // COMPLETE ALBUM"
                                       Style="{StaticResource HiTechPanelHeadingStyle}" />
                            <TextBlock Text="Scan the active album and generate missing 256px cache thumbnails. Existing valid cache entries are not regenerated. Internal .album files and nested albums are excluded."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource HiTechTextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="GenerateMissingThumbnailsButton"
                                        Content="GENERATE MISSING THUMBNAILS"
                                        Click="OnGenerateMissingThumbnails"
                                        Style="{StaticResource HiTechPrimaryButtonStyle}" />
                                <Button x:Name="CancelThumbnailGenerationButton"
                                        Content="CANCEL"
                                        Click="OnCancelThumbnailGeneration"
                                        IsEnabled="False"
                                        Style="{StaticResource HiTechSecondaryButtonStyle}" />
                            </StackPanel>
                            <controls:CinematicProgressBar x:Name="ThumbnailGenerationProgressBar"
                                         Minimum="0" Maximum="100" Visibility="Collapsed" />
                            <TextBlock x:Name="ThumbnailGenerationStatusText"
                                       Text="Thumbnail generation has not been run."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource HiTechAccentBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Album-specific recent tag shortcuts (global display count). -->
                    <Border Style="{StaticResource HiTechModuleStyle}" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="TAGS // RECENT HISTORY"
                                       Style="{StaticResource HiTechPanelHeadingStyle}" />
                            <TextBlock Text="Number of recently assigned tags shown below Add tag. Set 0 to hide the shortcuts. The history is kept separately for each album."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource HiTechTextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <NumberBox x:Name="RecentTagCountNumberBox"
                                           Header="VISIBLE RECENT TAGS"
                                           Minimum="0" Maximum="20" SmallChange="1" LargeChange="5"
                                           SpinButtonPlacementMode="Hidden"
                                           Width="190"
                                           AutomationProperties.AutomationId="RecentTagCountNumberBox" />
                                <Button x:Name="ClearRecentTagsButton"
                                        Content="CLEAR HISTORY"
                                        VerticalAlignment="Bottom"
                                        Click="OnClearRecentTagHistory"
                                        AutomationProperties.AutomationId="ClearRecentTagsButton"
                                        Style="{StaticResource HiTechSectionActionStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="RecentTagsSettingsStatusText"
                                       Text="History changes apply to the current album only."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource HiTechAccentBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Album JPEG conversion: explicit preview and confirmation before modifying files. -->
                    <Grid x:Name="AlbumSectionHeader" Height="34" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Width="4" Height="22"
                                   Fill="{StaticResource HiTechAccentBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="ALBUM // JPEG CONVERSION"
                                       Style="{StaticResource HiTechPanelHeadingStyle}" />
                            <TextBlock Text="LOCAL FILE CONVERSION + XMP EMBEDDING"
                                       Style="{StaticResource HiTechTinyLabelStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="SEC // 03"
                                   Style="{StaticResource HiTechTinyLabelStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Border Style="{StaticResource HiTechModuleStyle}" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Convert supported images in the active album to JPEG (including subfolders). Existing JPEGs with an XMP sidecar receive the full sidecar packet without recompression."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource HiTechTextSecondaryBrush}" />
                            <TextBlock Text="Optionally keep original files and sidecars in .album/jpeg-conversion-backups; disabling backup permanently discards originals after each verified conversion. Existing destination JPEGs are never overwritten. RAW, video and unsupported formats are skipped. Non-JPEG images are lossy-encoded to JPEG."
                                       TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource HiTechTextSecondaryBrush}" />
                            <CheckBox x:Name="KeepJpegConversionBackupsCheckBox"
                                      Content="KEEP ORIGINALS / XMP BACKUPS (RECOMMENDED)"
                                      IsChecked="True"
                                      Foreground="{StaticResource HiTechTextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="PreviewJpegConversionButton" Content="SCAN ALBUM"
                                        Click="OnPreviewJpegConversion"
                                        AutomationProperties.AutomationId="PreviewJpegConversionButton"
                                        Style="{StaticResource HiTechPrimaryButtonStyle}" />
                                <Button x:Name="RunJpegConversionButton" Content="CONVERT TO JPG"
                                        IsEnabled="False"
                                        Click="OnRunJpegConversion"
                                        AutomationProperties.AutomationId="RunJpegConversionButton"
                                        Style="{StaticResource HiTechPrimaryButtonStyle}" />
                                <Button x:Name="CancelJpegConversionButton" Content="CANCEL"
                                        IsEnabled="False"
                                        Click="OnCancelJpegConversion"
                                        Style="{StaticResource HiTechSecondaryButtonStyle}" />
                            </StackPanel>
                            <controls:CinematicProgressBar x:Name="JpegConversionProgressBar"
                                         Minimum="0" Maximum="100" Value="0"
                                         Visibility="Collapsed" />
                            <TextBlock x:Name="JpegConversionStatusText"
                                       Text="Scan the active album to preview the conversion."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource HiTechAccentBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Album-wide cleanup: only keywords, flags and tag vocabulary. -->
                    <Grid Height="34" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Width="4" Height="22"
                                   Fill="{StaticResource HiTechAccentBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="ALBUM // RESET TAGS"
                                       Style="{StaticResource HiTechPanelHeadingStyle}" />
                            <TextBlock Text="CLEAR TAGS, FLAGS AND TAG CATALOG"
                                       Style="{StaticResource HiTechTinyLabelStyle}" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource HiTechModuleStyle}" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Remove all image tags, user flags and catalog tag names in the active album. Photos, ratings, captions and capture dates are preserved. By default, originals and XMP are backed up before changes; you can disable retained backups at your own risk."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource HiTechTextSecondaryBrush}" />
                            <CheckBox x:Name="KeepAlbumResetBackupsCheckBox"
                                      Content="KEEP MODIFIED IMAGE / XMP BACKUPS (RECOMMENDED)"
                                      IsChecked="True"
                                      Foreground="{StaticResource HiTechTextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ClearAlbumMetadataButton"
                                        Content="CLEAR ALBUM TAGS + FLAGS"
                                        Click="OnClearAlbumMetadata"
                                        AutomationProperties.AutomationId="ClearAlbumMetadataButton"
                                        Style="{StaticResource HiTechPrimaryButtonStyle}" />
                                <Button x:Name="RetryFailedAlbumMetadataButton"
                                        Content="RETRY FAILED ONLY"
                                        Click="OnRetryFailedAlbumMetadata"
                                        AutomationProperties.AutomationId="RetryFailedAlbumMetadataButton"
                                        Style="{StaticResource HiTechSectionActionStyle}" />
                                <Button x:Name="CancelClearAlbumButton"
                                        Content="CANCEL"
                                        Click="OnCancelClearAlbum"
                                        IsEnabled="False"
                                        Style="{StaticResource HiTechSecondaryButtonStyle}" />
                            </StackPanel>
                            <controls:CinematicProgressBar x:Name="ClearAlbumProgressBar"
                                         Minimum="0" Maximum="100"
                                         Visibility="Collapsed" />
                            <TextBlock x:Name="ClearAlbumStatusText"
                                       Text="Album cleanup has not been run."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource HiTechAccentBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Full privacy cleanup. Different from keyword-only reset. -->
                    <Grid Height="34" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Width="4" Height="22"
                                   Fill="#FFBF40" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="ALBUM // ANONYMIZE METADATA"
                                       Style="{StaticResource HiTechPanelHeadingStyle}" />
                            <TextBlock Text="EXIF / IPTC / XMP / GPS / TAGS / PEOPLE"
                                       Style="{StaticResource HiTechTinyLabelStyle}" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource HiTechModuleStyle}" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Remove embedded photo metadata, XMP sidecars, photo tag assignments, flags, ratings and recognized-face data. JPEG, PNG and WebP are cleaned without changing encoded image pixels. BMP, TIFF and orientation-bearing images may be re-encoded. RAW, HEIC, AVIF, GIF, video and unsafe formats are skipped and reported."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource HiTechTextSecondaryBrush}" />
                            <TextBlock Text="Anonymization does NOT hide visible people or personal details in the picture, rename files, clear the Windows thumbnail cache, or remove earlier backups. Retained backups contain the original identifying metadata: do not distribute the .album directory. Test on a copy of the album first."
                                       TextWrapping="Wrap"
                                       Foreground="#FFBF40" FontSize="11" />
                            <CheckBox x:Name="KeepPrivacyBackupsCheckBox"
                                      Content="KEEP ORIGINAL IMAGE / XMP BACKUPS (RECOMMENDED)"
                                      IsChecked="True"
                                      Foreground="{StaticResource HiTechTextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AnonymizeAlbumButton"
                                        Content="ANONYMIZE ENTIRE ALBUM"
                                        Click="OnAnonymizeAlbum"
                                        AutomationProperties.AutomationId="AnonymizeAlbumButton"
                                        Style="{StaticResource HiTechPrimaryButtonStyle}" />
                                <Button x:Name="CancelAnonymizeAlbumButton"
                                        Content="CANCEL" IsEnabled="False"
                                        Click="OnCancelAnonymizeAlbum"
                                        Style="{StaticResource HiTechSecondaryButtonStyle}" />
                            </StackPanel>
                            <controls:CinematicProgressBar x:Name="AnonymizeAlbumProgressBar"
                                         Minimum="0" Maximum="100"
                                         Visibility="Collapsed" />
                            <TextBlock x:Name="AnonymizeAlbumStatusText"
                                       Text="Album privacy cleanup has not been run."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource HiTechAccentBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Album deletion lives alongside conversion and reset actions. -->
                    <Border Style="{StaticResource HiTechModuleStyle}" Padding="16">
                        <StackPanel Spacing="9">
                            <TextBlock Text="ALBUM // DELETE"
                                       Style="{StaticResource HiTechPanelHeadingStyle}"
                                       Foreground="#FF7180" />
                            <TextBlock Text="Remove the album catalog and associated XMP sidecars. Original photo and video files are preserved. Requires explicit confirmation."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource HiTechTextSecondaryBrush}" />
                                <Button x:Name="DeleteAlbumButton"
                                                    Content="DELETE ALBUM"
                                                    Click="OnDeleteAlbum"
                                                    Padding="18,10"
                                                    FontFamily="Consolas"
                                                    FontWeight="SemiBold"
                                                    BorderBrush="#FF4657"
                                                    BorderThickness="2"
                                                    Background="#321016"
                                                    Foreground="#FF7180"
                                                    ToolTipService.ToolTip="Remove PhotoLibrarian catalog files; keep your photographs" />
                        </StackPanel>
                    </Border>

                    <!-- About section -->
                    <Grid x:Name="AboutSectionHeader" Height="34" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Width="4"
                                   Height="22"
                                   Fill="{StaticResource HiTechAccentBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0">
                            <TextBlock Text="RUNTIME IDENTITY"
                                       Style="{StaticResource HiTechPanelHeadingStyle}" />
                            <TextBlock Text="APPLICATION / LOCAL-FIRST"
                                       Style="{StaticResource HiTechTinyLabelStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="SEC // 03"
                                   Style="{StaticResource HiTechTinyLabelStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource HiTechModuleStyle}"
                            Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <Image Width="220" Height="72" HorizontalAlignment="Left"
                                       Stretch="Uniform" Margin="0,0,0,6">
                                    <Image.Source>
                                        <SvgImageSource UriSource="ms-appx:///Assets/trimenor-horizontal-dark.svg"/>
                                    </Image.Source>
                                </Image>
                                <TextBlock Text="PHOTOLIBRARIAN"
                                           FontFamily="Consolas"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource HiTechTextPrimaryBrush}" />
                                <TextBlock Text="A local-first portable photo library by Trimenor."
                                           
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="{StaticResource HiTechTextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="BUILD"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource HiTechTinyLabelStyle}" />
                                <TextBlock x:Name="InstalledVersionText"
                                           Text="1.1.0"
                                           HorizontalAlignment="Right"
                                           FontFamily="Consolas"
                                           FontSize="14"
                                           Foreground="{StaticResource HiTechAccentBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource HiTechModuleStyle}" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="SYSTEM // UPDATE CONTROL"
                                       Style="{StaticResource HiTechPanelHeadingStyle}"/>
                            <TextBlock Text="Updates are checked manually. Stable releases come from master; development prereleases are optional."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource HiTechTextSecondaryBrush}"/>
                             <ToggleSwitch x:Name="DevelopmentUpdatesToggle"
                                           Header="INCLUDE DEVELOPMENT UPDATES"
                                           OffContent="Stable releases only"
                                           OnContent="Stable + development prereleases"
                                           Toggled="OnDevelopmentUpdatesToggled"
                                           AutomationProperties.AutomationId="DevelopmentUpdatesToggle"/>
                             <TextBlock Text="Development builds may contain bugs. Stable is the default."
                                        TextWrapping="Wrap"
                                        Foreground="{StaticResource HiTechTextSecondaryBrush}"/>
                            <TextBlock x:Name="UpdateStatusText" Text="No update check performed."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource HiTechAccentBrush}"/>
                            <controls:CinematicProgressBar x:Name="UpdateDownloadProgress" Minimum="0" Maximum="100"
                                         Visibility="Collapsed"/>
                            <Button x:Name="CheckUpdatesButton" Content="CHECK FOR UPDATES"
                                    Click="OnCheckForUpdatesClick"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="CheckUpdatesButton"
                                    Style="{StaticResource HiTechPrimaryButtonStyle}"/>
                        </StackPanel>
                    </Border>

<!-- Allow even the final ABOUT header to align at the top of
                         the viewport when navigated to from the left panel. -->
                    <Border x:Name="SettingsNavigationEndSpacer"
                            Height="0"
                            IsHitTestVisible="False" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer command rail -->
        <Grid Grid.Row="2"
              Background="{StaticResource HiTechPanelBackgroundBrush}"
              BorderBrush="{StaticResource HiTechBorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <TextBlock Text="SYS"
                           Style="{StaticResource HiTechTinyLabelStyle}"
                           Foreground="{StaticResource HiTechAccentBrush}" />
                <Rectangle Width="24"
                           Height="1"
                           Fill="{StaticResource HiTechAccentMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="CONFIGURATION MODE"
                           Style="{StaticResource HiTechTinyLabelStyle}" />
            </StackPanel>
            <Button Grid.Column="1"
                    MinWidth="144"
                    Height="34"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    AutomationProperties.AutomationId="CloseSettingsButton"
                    Content="CLOSE CONFIG"
                    Click="OnClose"
                    Style="{StaticResource HiTechSecondaryButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
