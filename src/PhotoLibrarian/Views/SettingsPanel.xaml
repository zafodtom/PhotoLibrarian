<UserControl
    x:Class="PhotoLibrarian.Views.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource HiTechAppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <!-- Settings global header -->
        <Grid Grid.Row="0"
              Background="#0A121A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="22,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Width="4"
                           Fill="{StaticResource HiTechAccentBrush}" />
                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="SYSTEM // CONFIG"
                               FontFamily="Consolas"
                               FontSize="18"
                               FontWeight="SemiBold"
                               CharacterSpacing="100"
                               Foreground="{StaticResource HiTechTextPrimaryBrush}" />
                    <TextBlock Text="PHOTOLIBRARIAN CONTROL MATRIX"
                               Style="{StaticResource HiTechTinyLabelStyle}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="2">
                <TextBlock Text="CONFIGURATION CONSOLE"
                           HorizontalAlignment="Center"
                           Style="{StaticResource HiTechSectionHeaderStyle}"
                           FontSize="13" />
                <TextBlock Text="IMPORT / CACHE / SYSTEM"
                           HorizontalAlignment="Center"
                           Style="{StaticResource HiTechTinyLabelStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,22,0">
                <TextBlock Text="ACCESS"
                           HorizontalAlignment="Right"
                           Style="{StaticResource HiTechTinyLabelStyle}" />
                <TextBlock Text="LOCAL ADMIN"
                           HorizontalAlignment="Right"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="{StaticResource HiTechAccentBrush}" />
            </StackPanel>

            <Rectangle Grid.ColumnSpan="3"
                       Height="1"
                       Fill="{StaticResource HiTechAccentMutedBrush}"
                       VerticalAlignment="Bottom" />
            <Rectangle Grid.ColumnSpan="3"
                       Width="110"
                       Height="2"
                       Fill="{StaticResource HiTechAccentBrush}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="22,0,0,-1" />
        </Grid>

        <!-- Settings body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left system map -->
            <Border Grid.Column="0"
                    Background="#091018"
                    BorderBrush="{StaticResource HiTechBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="8">
                        <TextBlock Text="CONFIG MAP"
                                   Style="{StaticResource HiTechTinyLabelStyle}" />
                        <Rectangle Height="1"
                                   Fill="{StaticResource HiTechAccentMutedBrush}" />

                        <Border Style="{StaticResource HiTechModuleStyle}"
                                Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="01"
                                           FontFamily="Consolas"
                                           FontSize="14"
                                           Foreground="{StaticResource HiTechAccentBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="IMPORT"
                                               Style="{StaticResource HiTechSectionHeaderStyle}" />
                                    <TextBlock Text="External metadata"
                                               Style="{StaticResource HiTechTinyLabelStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource HiTechModuleStyle}"
                                Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="02"
                                           FontFamily="Consolas"
                                           FontSize="14"
                                           Foreground="{StaticResource HiTechAccentBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="CACHE"
                                               Style="{StaticResource HiTechSectionHeaderStyle}" />
                                    <TextBlock Text="Local performance"
                                               Style="{StaticResource HiTechTinyLabelStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource HiTechModuleStyle}"
                                Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="03"
                                           FontFamily="Consolas"
                                           FontSize="14"
                                           Foreground="{StaticResource HiTechAccentBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="ABOUT"
                                               Style="{StaticResource HiTechSectionHeaderStyle}" />
                                    <TextBlock Text="Runtime identity"
                                               Style="{StaticResource HiTechTinyLabelStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Spacing="5">
                        <TextBlock Text="NODE // LOCAL"
                                   Style="{StaticResource HiTechTinyLabelStyle}" />
                        <Rectangle Width="44"
                                   Height="1"
                                   Fill="{StaticResource HiTechAccentMutedBrush}" />
                        <TextBlock Text="NO CLOUD LINK"
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   Foreground="{StaticResource HiTechTextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main settings modules -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="24,18,28,24"
                            Spacing="16"
                            MaxWidth="1050">

                    <!-- Import section -->
                    <Grid Height="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Width="4"
                                   Height="22"
                                   Fill="{StaticResource HiTechAccentBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0">
                            <TextBlock Text="LIBRARY IMPORT"
                                       Style="{StaticResource HiTechSectionHeaderStyle}" />
                            <TextBlock Text="READ-ONLY EXTERNAL METADATA INGEST"
                                       Style="{StaticResource HiTechTinyLabelStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="SEC // 01"
                                   Style="{StaticResource HiTechTinyLabelStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Foreground="{StaticResource HiTechTextSecondaryBrush}"
                               Text="Import existing tags and metadata into the currently open album. Source databases are opened read-only and are never modified."
                               FontFamily="Consolas"
                               FontSize="11"
                               TextWrapping="Wrap" />

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource HiTechModuleStyle}"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DIGIKAM"
                                                   Style="{StaticResource HiTechSectionHeaderStyle}" />
                                        <TextBlock Text="SOURCE / digikam4.db"
                                                   Style="{StaticResource HiTechTinyLabelStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="EXT-A"
                                               Style="{StaticResource HiTechTinyLabelStyle}" />
                                </Grid>
                                <Rectangle Height="1"
                                           Fill="{StaticResource HiTechBorderBrush}" />
                                <TextBlock Foreground="{StaticResource HiTechTextSecondaryBrush}"
                                           Text="Imports tag hierarchy, tag assignments, and captions from digikam4.db."
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10">
                                    <Button x:Name="ImportDigiKamButton"
                                            AutomationProperties.AutomationId="ImportDigiKamButton"
                                            Content="IMPORT DIGIKAM"
                                            Click="OnImportDigiKam"
                                            Style="{StaticResource HiTechPrimaryButtonStyle}" />
                                    <ProgressRing x:Name="DigiKamImportProgressRing"
                                                  Width="20"
                                                  Height="20"
                                                  IsActive="False"
                                                  Visibility="Collapsed" />
                                </StackPanel>
                                <ProgressBar x:Name="DigiKamImportProgressBar"
                                             Minimum="0"
                                             Maximum="100"
                                             Visibility="Collapsed" />
                                <TextBlock x:Name="DigiKamImportStatusText"
                                           Foreground="{StaticResource HiTechTextSecondaryBrush}"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource HiTechModuleStyle}"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="STASH"
                                                   Style="{StaticResource HiTechSectionHeaderStyle}" />
                                        <TextBlock Text="SOURCE / SQLITE OR BACKUP ZIP"
                                                   Style="{StaticResource HiTechTinyLabelStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="EXT-B"
                                               Style="{StaticResource HiTechTinyLabelStyle}" />
                                </Grid>
                                <Rectangle Height="1"
                                           Fill="{StaticResource HiTechBorderBrush}" />
                                <TextBlock Foreground="{StaticResource HiTechTextSecondaryBrush}"
                                           Text="Imports image tags from stash-go.sqlite or directly from a Stash backup ZIP."
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10">
                                    <Button x:Name="ImportStashButton"
                                            AutomationProperties.AutomationId="ImportStashButton"
                                            Content="IMPORT STASH"
                                            Click="OnImportStash"
                                            Style="{StaticResource HiTechPrimaryButtonStyle}" />
                                    <ProgressRing x:Name="StashImportProgressRing"
                                                  Width="20"
                                                  Height="20"
                                                  IsActive="False"
                                                  Visibility="Collapsed" />
                                </StackPanel>
                                <ProgressBar x:Name="StashImportProgressBar"
                                             Minimum="0"
                                             Maximum="100"
                                             Visibility="Collapsed" />
                                <TextBlock x:Name="StashImportStatusText"
                                           Foreground="{StaticResource HiTechTextSecondaryBrush}"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Cache section -->
                    <Grid Height="34" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Width="4"
                                   Height="22"
                                   Fill="{StaticResource HiTechAccentBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0">
                            <TextBlock Text="CACHE CONTROL"
                                       Style="{StaticResource HiTechSectionHeaderStyle}" />
                            <TextBlock Text="LOCAL THUMBNAIL STORAGE"
                                       Style="{StaticResource HiTechTinyLabelStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="SEC // 02"
                                   Style="{StaticResource HiTechTinyLabelStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource HiTechModuleStyle}"
                            Padding="16">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="CACHE STATUS"
                                           Style="{StaticResource HiTechTinyLabelStyle}" />
                                <TextBlock x:Name="CacheSizeText"
                                           FontFamily="Consolas"
                                           FontSize="16"
                                           Foreground="{StaticResource HiTechAccentBrush}"
                                           Text="Cache size: calculating…" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="LOCATION"
                                           Style="{StaticResource HiTechTinyLabelStyle}" />
                                <TextBlock x:Name="CachePathText"
                                           Foreground="{StaticResource HiTechTextSecondaryBrush}"
                                           IsTextSelectionEnabled="True"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    AutomationProperties.AutomationId="RebuildCacheButton"
                                    VerticalAlignment="Center"
                                    Content="REBUILD CACHE"
                                    Click="OnRebuildCache"
                                    Style="{StaticResource HiTechPrimaryButtonStyle}" />
                        </Grid>
                    </Border>

                    <!-- About section -->
                    <Grid Height="34" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Width="4"
                                   Height="22"
                                   Fill="{StaticResource HiTechAccentBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0">
                            <TextBlock Text="RUNTIME IDENTITY"
                                       Style="{StaticResource HiTechSectionHeaderStyle}" />
                            <TextBlock Text="APPLICATION / LOCAL-FIRST"
                                       Style="{StaticResource HiTechTinyLabelStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="SEC // 03"
                                   Style="{StaticResource HiTechTinyLabelStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource HiTechModuleStyle}"
                            Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="PHOTOLIBRARIAN"
                                           FontFamily="Consolas"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource HiTechTextPrimaryBrush}" />
                                <TextBlock Text="A local-first portable photo library."
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="{StaticResource HiTechTextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="BUILD"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource HiTechTinyLabelStyle}" />
                                <TextBlock Text="1.0.0"
                                           HorizontalAlignment="Right"
                                           FontFamily="Consolas"
                                           FontSize="14"
                                           Foreground="{StaticResource HiTechAccentBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer command rail -->
        <Grid Grid.Row="2"
              Background="#091018"
              BorderBrush="{StaticResource HiTechBorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="16,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <TextBlock Text="SYS"
                           Style="{StaticResource HiTechTinyLabelStyle}"
                           Foreground="{StaticResource HiTechAccentBrush}" />
                <Rectangle Width="24"
                           Height="1"
                           Fill="{StaticResource HiTechAccentMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="CONFIGURATION MODE"
                           Style="{StaticResource HiTechTinyLabelStyle}" />
            </StackPanel>
            <Button Grid.Column="1"
                    AutomationProperties.AutomationId="CloseSettingsButton"
                    Content="CLOSE CONFIG"
                    Click="OnClose"
                    Style="{StaticResource HiTechIconButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
