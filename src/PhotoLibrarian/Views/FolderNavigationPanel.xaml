<UserControl
    x:Class="PhotoLibrarian.Views.FolderNavigationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PhotoLibrarian.ViewModels">

    <Grid Padding="12"
          Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with actions -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Rectangle Width="3"
                           Height="18"
                           Fill="{StaticResource HiTechAccentBrush}" />
                <TextBlock Text="BROWSE"
                           Style="{StaticResource HiTechSectionHeaderStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                <Button x:Name="ManageFoldersButton" ToolTipService.ToolTip="Open another album"
                        AutomationProperties.Name="Open another album"
                        Click="OnManageFoldersClick" Padding="6"
                        Style="{StaticResource HiTechIconButtonStyle}">
                    <PathIcon Data="M2,5 L9,5 11,7 22,7 22,19 2,19 Z" Width="14" Height="14" />
                </Button>
                <Button x:Name="RefreshButton" ToolTipService.ToolTip="Refresh"
                        Click="OnRefreshClick" Padding="6"
                        Style="{StaticResource HiTechIconButtonStyle}">
                    <PathIcon Data="M20,7 L20,2 18,4 A9,9 0 1 0 21,12 L19,12 A7,7 0 1 1 17,5 L14,7 Z" Width="14" Height="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Sections: Library, Date, People, Tags, Flags -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <Grid Height="18">
                    <TextBlock Text="NAV / INDEX"
                               Style="{StaticResource HiTechTinyLabelStyle}"
                               VerticalAlignment="Center" />
                    <Rectangle Height="1"
                               Margin="78,0,0,0"
                               Fill="{StaticResource HiTechAccentMutedBrush}"
                               VerticalAlignment="Center" />
                </Grid>
                
                <!-- Library Section -->
                <Border Style="{StaticResource HiTechModuleStyle}">
                    <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Width="3" Height="14"
                                   Fill="{StaticResource HiTechAccentBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="LIBRARY"
                                   Style="{StaticResource HiTechSectionHeaderStyle}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="A01"
                                   Style="{StaticResource HiTechTinyLabelStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TreeView x:Name="LibraryTree"
                              Style="{StaticResource HiTechTreeViewStyle}"
                              SelectionMode="None"
                              Expanding="OnLibraryExpanding"
                              RightTapped="OnLibraryTreeRightTapped">
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <CheckBox IsChecked="{Binding Content.IsSelected, Mode=TwoWay}"
                                              Tag="{Binding Content}"
                                              Click="OnFolderFilterCheckBoxClick"
                                              VerticalAlignment="Center"
                                              Width="20"
                                              MinWidth="0"
                                              Padding="0"
                                              Margin="0" />
                                    <PathIcon Data="M2,5 L9,5 11,7 22,7 22,19 2,19 Z" Width="13" Height="13" Foreground="{StaticResource HiTechAccentBrush}" VerticalAlignment="Center" />
                                    <PathIcon Data="M3,3 L13,3 22,12 12,22 3,13 Z M8,7 A1.5,1.5 0 1 0 8,10 A1.5,1.5 0 1 0 8,7 Z" Width="13" Height="13" Foreground="{StaticResource HiTechAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Content}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    </StackPanel>
                </Border>

                <!-- Date navigation retained in code, hidden for the current album UI. -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Text="Date" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TreeView x:Name="DateTree"
                              SelectionMode="Multiple"
                              ItemInvoked="OnDateItemInvoked"
                              SelectionChanged="OnDateSelectionChanged" />
                </StackPanel>

                <!-- People Section retained in code for compatibility, hidden in album-focused UI. -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Text="People" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TreeView x:Name="PeopleTree"
                              AutomationProperties.AutomationId="PeopleTree"
                              AutomationProperties.Name="People"
                              SelectionMode="Multiple"
                              ItemInvoked="OnPeopleItemInvoked"
                              SelectionChanged="OnPeopleSelectionChanged" />
                </StackPanel>

                <!-- Tags Section -->
                <Border Style="{StaticResource HiTechModuleStyle}">
                    <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Rectangle Width="3" Height="14"
                                       Fill="{StaticResource HiTechAccentBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="TAGS"
                                       Style="{StaticResource HiTechSectionHeaderStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="B02"
                                       Style="{StaticResource HiTechTinyLabelStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="2">
                            <Button Click="OnManageTagCatalogClick"
                                    Padding="5,3"
                                    Style="{StaticResource HiTechIconButtonStyle}"
                                    ToolTipService.ToolTip="Manage tag catalog"
                                    AutomationProperties.Name="Manage tag catalog">
                                <PathIcon Data="M19.14,12.94 A7.9,7.9 0 0 0 19.2,11.06 L21,9.66 19,6.2 16.88,7.03 A7.8,7.8 0 0 0 15.25,6.08 L14.93,3.8 10.93,3.8 10.61,6.08 A7.8,7.8 0 0 0 8.98,7.03 L6.86,6.2 4.86,9.66 6.66,11.06 A7.9,7.9 0 0 0 6.66,12.94 L4.86,14.34 6.86,17.8 8.98,16.97 A7.8,7.8 0 0 0 10.61,17.92 L10.93,20.2 14.93,20.2 15.25,17.92 A7.8,7.8 0 0 0 16.88,16.97 L19,17.8 21,14.34 Z M12.93,15 A3,3 0 1 1 12.93,9 A3,3 0 1 1 12.93,15 Z" Width="14" Height="14" Foreground="{StaticResource HiTechAccentBrush}" />
                            </Button>
                            <Button Click="OnExpandAllTagsClick"
                                    Padding="5,3"
                                    Style="{StaticResource HiTechIconButtonStyle}"
                                    ToolTipService.ToolTip="Expand all tags"
                                    AutomationProperties.Name="Expand all tags">
                                <PathIcon Data="M4,14 L12,6 20,14 18,16 12,10 6,16 Z" Width="12" Height="12" />
                            </Button>
                            <Button Click="OnCollapseAllTagsClick"
                                    Padding="5,3"
                                    Style="{StaticResource HiTechIconButtonStyle}"
                                    ToolTipService.ToolTip="Collapse all tags"
                                    AutomationProperties.Name="Collapse all tags">
                                <PathIcon Data="M4,10 L6,8 12,14 18,8 20,10 12,18 Z" Width="12" Height="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TreeView x:Name="TagsTree"
                              Style="{StaticResource HiTechTreeViewStyle}"
                              SelectionMode="None"
                              CanDragItems="False"
                              CanReorderItems="False"
                              AllowDrop="True"
                              DragOver="OnTagsTreeDragOver"
                              Drop="OnTagsTreeDrop">
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <CheckBox IsChecked="{Binding Content.IsSelected, Mode=TwoWay}"
                                              Tag="{Binding Content}"
                                              Click="OnTagFilterCheckBoxClick"
                                              VerticalAlignment="Center"
                                              Width="20"
                                              MinWidth="0"
                                              Padding="0"
                                              Margin="0" />
                                    <TextBlock Text="{Binding Content}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    </StackPanel>
                </Border>

                <!-- Flags retained in code, hidden for the current album UI. -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Text="Flags" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TreeView x:Name="FlagsTree"
                              SelectionMode="Multiple"
                              ItemInvoked="OnFlagsItemInvoked"
                              SelectionChanged="OnFlagsSelectionChanged">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="TreeViewNode">
                                <TreeViewItem ItemsSource="{x:Bind Children}">
                                    <TextBlock Text="{Binding Content.Label}" />
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
