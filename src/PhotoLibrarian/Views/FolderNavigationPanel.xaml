<UserControl
    x:Class="PhotoLibrarian.Views.FolderNavigationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PhotoLibrarian.ViewModels">

    <Grid Padding="12"
          Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with actions -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Rectangle Width="3"
                           Height="18"
                           Fill="{StaticResource HiTechAccentBrush}" />
                <TextBlock Text="BROWSE"
                           Style="{StaticResource HiTechSectionHeaderStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                <Button x:Name="ManageFoldersButton" ToolTipService.ToolTip="Open another album"
                        AutomationProperties.Name="Open another album"
                        Click="OnManageFoldersClick" Padding="6"
                        Style="{StaticResource HiTechIconButtonStyle}">
                    <Viewbox Width="14" Height="14"><Path Data="M2,7 L2,20 L22,20 L22,8 L11,8 L8,5 L2,5 Z" Stroke="{StaticResource HiTechAccentBrush}" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox>
                </Button>
                <Button x:Name="RefreshButton" ToolTipService.ToolTip="Refresh"
                        Click="OnRefreshClick" Padding="6"
                        Style="{StaticResource HiTechIconButtonStyle}">
                    <Viewbox Width="14" Height="14"><Path Data="M20,8 A9,9 0 1 0 21,15 M20,3 L20,9 L14,9" Stroke="{StaticResource HiTechAccentBrush}" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Sections: Library, Date, People, Tags, Flags -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <Grid Height="18">
                    <TextBlock Text="NAV / INDEX"
                               Style="{StaticResource HiTechTinyLabelStyle}"
                               VerticalAlignment="Center" />
                    <Rectangle Height="1"
                               Margin="78,0,0,0"
                               Fill="{StaticResource HiTechAccentMutedBrush}"
                               VerticalAlignment="Center" />
                </Grid>
                
                <!-- Library Section -->
                <Border Style="{StaticResource HiTechModuleStyle}">
                    <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Width="3" Height="14"
                                   Fill="{StaticResource HiTechAccentBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="LIBRARY"
                                   Style="{StaticResource HiTechSectionHeaderStyle}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="A01"
                                   Style="{StaticResource HiTechTinyLabelStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TreeView x:Name="LibraryTree"
                              Style="{StaticResource HiTechTreeViewStyle}"
                              SelectionMode="None"
                              Expanding="OnLibraryExpanding"
                              RightTapped="OnLibraryTreeRightTapped">
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <CheckBox IsChecked="{Binding Content.IsSelected, Mode=TwoWay}"
                                              Tag="{Binding Content}"
                                              Click="OnFolderFilterCheckBoxClick"
                                              VerticalAlignment="Center"
                                              Width="20"
                                              MinWidth="0"
                                              Padding="0"
                                              Margin="0" />
                                    <Viewbox Width="14" Height="14"><Path Data="M2,7 L2,20 L22,20 L22,8 L11,8 L8,5 L2,5 Z" Stroke="{StaticResource HiTechAccentBrush}" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox>
                                    <Viewbox Width="14" Height="14"><Grid Width="24" Height="24"><Path Data="M3,3 L13,3 L21,12 L12,21 L3,12 Z" Stroke="{StaticResource HiTechAccentBrush}" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent"/><Ellipse Width="3" Height="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0" Fill="{StaticResource HiTechAccentBrush}"/></Grid></Viewbox>
                                    <TextBlock Text="{Binding Content}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    </StackPanel>
                </Border>

                <!-- Date navigation retained in code, hidden for the current album UI. -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Text="Date" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TreeView x:Name="DateTree"
                              SelectionMode="Multiple"
                              ItemInvoked="OnDateItemInvoked"
                              SelectionChanged="OnDateSelectionChanged" />
                </StackPanel>

                <!-- People Section retained in code for compatibility, hidden in album-focused UI. -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Text="People" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TreeView x:Name="PeopleTree"
                              AutomationProperties.AutomationId="PeopleTree"
                              AutomationProperties.Name="People"
                              SelectionMode="Multiple"
                              ItemInvoked="OnPeopleItemInvoked"
                              SelectionChanged="OnPeopleSelectionChanged" />
                </StackPanel>

                <!-- Tags Section -->
                <Border Style="{StaticResource HiTechModuleStyle}">
                    <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Rectangle Width="3" Height="14"
                                       Fill="{StaticResource HiTechAccentBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="TAGS"
                                       Style="{StaticResource HiTechSectionHeaderStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="B02"
                                       Style="{StaticResource HiTechTinyLabelStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="2">
                            <Button Click="OnManageTagCatalogClick"
                                    Padding="5,3"
                                    Style="{StaticResource HiTechIconButtonStyle}"
                                    ToolTipService.ToolTip="Manage tag catalog"
                                    AutomationProperties.Name="Manage tag catalog">
                                <Viewbox Width="16" Height="16"><Grid Width="24" Height="24"><Path Data="M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M19.1,4.9 L17,7 M7,17 L4.9,19.1" Stroke="{StaticResource HiTechAccentBrush}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Ellipse Width="13" Height="13" Stroke="{StaticResource HiTechAccentBrush}" StrokeThickness="2.6"/><Ellipse Width="4" Height="4" Stroke="{StaticResource HiTechAccentBrush}" StrokeThickness="2"/></Grid></Viewbox>
                            </Button>
                            <Button Click="OnExpandAllTagsClick"
                                    Padding="5,3"
                                    Style="{StaticResource HiTechIconButtonStyle}"
                                    ToolTipService.ToolTip="Expand all tags"
                                    AutomationProperties.Name="Expand all tags">
                                <Viewbox Width="12" Height="12"><Path Data="M4,15 L12,7 L20,15" Stroke="{StaticResource HiTechAccentBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Viewbox>
                            </Button>
                            <Button Click="OnCollapseAllTagsClick"
                                    Padding="5,3"
                                    Style="{StaticResource HiTechIconButtonStyle}"
                                    ToolTipService.ToolTip="Collapse all tags"
                                    AutomationProperties.Name="Collapse all tags">
                                <Viewbox Width="12" Height="12"><Path Data="M4,9 L12,17 L20,9" Stroke="{StaticResource HiTechAccentBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TreeView x:Name="TagsTree"
                              Style="{StaticResource HiTechTreeViewStyle}"
                              SelectionMode="None"
                              CanDragItems="False"
                              CanReorderItems="False"
                              AllowDrop="True"
                              DragOver="OnTagsTreeDragOver"
                              Drop="OnTagsTreeDrop">
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <CheckBox IsChecked="{Binding Content.IsSelected, Mode=TwoWay}"
                                              Tag="{Binding Content}"
                                              Click="OnTagFilterCheckBoxClick"
                                              VerticalAlignment="Center"
                                              Width="20"
                                              MinWidth="0"
                                              Padding="0"
                                              Margin="0" />
                                    <TextBlock Text="{Binding Content}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    </StackPanel>
                </Border>

                <!-- Flags retained in code, hidden for the current album UI. -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Text="Flags" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TreeView x:Name="FlagsTree"
                              SelectionMode="Multiple"
                              ItemInvoked="OnFlagsItemInvoked"
                              SelectionChanged="OnFlagsSelectionChanged">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="TreeViewNode">
                                <TreeViewItem ItemsSource="{x:Bind Children}">
                                    <TextBlock Text="{Binding Content.Label}" />
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
