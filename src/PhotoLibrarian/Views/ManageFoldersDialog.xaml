<ContentDialog
    x:Class="PhotoLibrarian.Views.ManageFoldersDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Manage Library Folders"
    RequestedTheme="Dark"
    PrimaryButtonText="Close"
    PrimaryButtonStyle="{StaticResource HiTechSectionActionStyle}"
    DefaultButton="None">

    <ContentDialog.Resources>
        <!-- Widen the native template rather than the ContentDialog itself. -->
        <x:Double x:Key="ContentDialogMaxWidth">660</x:Double>
    </ContentDialog.Resources>

    <Grid RowSpacing="12"
          MinHeight="360"
          Background="{StaticResource HiTechPanelBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Description -->
        <TextBlock Grid.Row="0" TextWrapping="Wrap"
                   Foreground="{StaticResource HiTechTextSecondaryBrush}" 
                   Text="Add or remove folders from your photo library. All photos and videos in these folders and their subfolders will be indexed." />

        <!-- Folder list -->
        <ListView Grid.Row="1" x:Name="FoldersList" 
                  SelectionMode="Single"
                  BorderBrush="{StaticResource HiTechBorderStrongBrush}"
                  BorderThickness="1"
                  CornerRadius="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="16" Margin="0,0,12,0"
                                  Foreground="{StaticResource HiTechAccentBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" 
                                Click="OnRemoveFolderItemClick"
                                Style="{StaticResource HiTechRailDangerButtonStyle}"
                                Padding="4"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Remove this folder">
                            <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{StaticResource HiTechDangerBrush}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Add folder button -->
        <Button Grid.Row="2" 
                x:Name="AddFolderBtn"
                Click="OnAddFolderClick"
                HorizontalAlignment="Stretch"
                Style="{StaticResource HiTechPrimaryButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE710;" />
                <TextBlock Text="Add Folder" />
            </StackPanel>
        </Button>
        
        <!-- Separator -->
        <Border Grid.Row="3" Height="1" Background="{StaticResource HiTechAccentMutedBrush}" Margin="0,12" />
        
        <!-- Database maintenance -->
        <StackPanel Grid.Row="4" Spacing="8">
            <TextBlock Text="DATABASE // MAINTENANCE"
                           Style="{StaticResource HiTechPanelHeadingStyle}" />
            <TextBlock TextWrapping="Wrap"
                           Foreground="{StaticResource HiTechTextSecondaryBrush}"
                       Text="Clear the database to rebuild the index with updated metadata or fix corruption. All photos will be re-scanned and re-indexed." />
            <Button x:Name="ClearDatabaseBtn"
                    Click="OnClearDatabaseClick"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource HiTechRailDangerButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemErrorTextColor}" />
                    <TextBlock Text="Clear Database and Re-Index" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</ContentDialog>
