<UserControl
    x:Class="PhotoLibrarian.Views.MetadataPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PhotoLibrarian.ViewModels">

    <UserControl.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,12,0,2" />
        </Style>
        <Style x:Key="PlaceholderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="90" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Empty state -->
        <StackPanel x:Name="EmptyContent" Visibility="Visible" Padding="16" VerticalAlignment="Center">
            <TextBlock Text="Select an image to see details"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Single ScrollViewer with a Grid inside; code-behind sets MinHeight
             on DetailGrid to match viewport so the * spacer row pushes info to bottom -->
        <ScrollViewer x:Name="DetailContent" Visibility="Collapsed"
                      SizeChanged="OnDetailScrollViewerSizeChanged">
            <Grid x:Name="DetailGrid" Padding="14,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ═══ Row 0: Editable sections ═══ -->
                <StackPanel Grid.Row="0" Spacing="0">
                    <!-- Multi-select header (visible only with multi) -->
                    <Border x:Name="MultiSelectBanner" Visibility="Collapsed"
                            Background="{ThemeResource AccentFillColorTertiaryBrush}"
                            Padding="8,6" CornerRadius="4" Margin="0,8,0,0">
                        <TextBlock x:Name="MultiSelectText"
                                   FontWeight="SemiBold" FontSize="13" />
                    </Border>

                    <TextBlock Text="People tags" Style="{StaticResource SectionHeaderStyle}" Visibility="Collapsed" />
                    <ItemsRepeater x:Name="PeopleTagsList" Margin="0,2,0,0" Visibility="Collapsed">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:PersonTagDisplayItem">
                                <Grid Tag="{x:Bind FaceId, Mode=OneWay}"
                                      ColumnSpacing="8"
                                      PointerEntered="OnPersonRowPointerEntered"
                                      PointerExited="OnPersonRowPointerExited">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="32" Height="32">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{x:Bind Thumbnail, Mode=OneWay}"
                                                        Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Name, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               FontSize="13" />
                                    <Button Grid.Column="2"
                                            Tag="{x:Bind FaceId, Mode=OneWay}"
                                            AutomationProperties.AutomationId="RemovePeopleTagButton"
                                            AutomationProperties.Name="Remove people tag"
                                            ToolTipService.ToolTip="Remove this people tag"
                                            Click="OnRemoveFaceTagClick"
                                            Padding="6"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <Button x:Name="AddPeopleTagsButton"
                            Visibility="Collapsed"
                            AutomationProperties.AutomationId="AddPeopleTagsButton"
                            AutomationProperties.Name="Add people tags"
                            Content="Add people tags"
                            Click="OnAddPeopleTagsClick"
                            HorizontalAlignment="Left"
                            Padding="8,4"
                            Margin="0,2,0,0" />

                    <TextBlock Text="Geotag" Style="{StaticResource SectionHeaderStyle}" Visibility="Collapsed" />
                    <TextBlock x:Name="GeotagText" Style="{StaticResource PlaceholderStyle}" Margin="0,2,0,0" Visibility="Collapsed" />

                    <TextBlock Text="Caption" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBox x:Name="CaptionBox"
                             PlaceholderText="Add caption"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="32"
                             MaxHeight="120"
                             Margin="0,4,0,0"
                             LostFocus="OnCaptionLostFocus" />
                    <TextBlock x:Name="CaptionMixedHint" Visibility="Collapsed"
                               Text="Multiple captions — typing here replaces all"
                               FontStyle="Italic" FontSize="11"
                               Foreground="{ThemeResource SystemAccentColorLight2}"
                               Margin="0,2,0,0" />

                    <TextBlock Text="Descriptive tags" Style="{StaticResource SectionHeaderStyle}" />
                    <ItemsRepeater x:Name="TagsList" Margin="0,4,0,0">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="2" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Tag}" FontSize="13"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding CountDisplay}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="4,0,0,0" />
                                    <Button Grid.Column="2" Padding="4,2"
                                            Background="Transparent" BorderThickness="0"
                                            Click="OnRemoveTagClick"
                                            Tag="{Binding Tag}"
                                            ToolTipService.ToolTip="Remove tag from all selected">
                                        <FontIcon Glyph="&#xE10A;" FontSize="10" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <StackPanel Margin="0,4,0,0" Spacing="4">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewTagBox" Grid.Column="0"
                                     PlaceholderText="Add or choose descriptive tag"
                                     TextChanged="OnTagTextChanged"
                                     KeyDown="OnNewTagKeyDown"
                                     FontSize="13" />
                            <Button Grid.Column="1"
                                    Click="OnShowAllTagsClick"
                                    Padding="6,4"
                                    ToolTipService.ToolTip="Show all available tags"
                                    AutomationProperties.Name="Show all available tags">
                                <FontIcon Glyph="&#xE70D;" FontSize="12" />
                            </Button>
                            <Button Grid.Column="2"
                                    Click="OnAddTagClick"
                                    Padding="6,4"
                                    ToolTipService.ToolTip="Add tag to all selected">
                                <FontIcon Glyph="&#xE109;" FontSize="12" />
                            </Button>
                        </Grid>

                        <!-- Inline suggestion dropdown. Keeping it in the visual tree avoids
                             the Flyout focus hand-off that interrupted typing. -->
                        <Border x:Name="TagSuggestionsPanel"
                                Visibility="Collapsed"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="6">
                                <Button Content="Nový tag"
                                        Click="OnNewCatalogTagClick"
                                        HorizontalAlignment="Stretch" />
                                <ListView x:Name="TagSuggestionsList"
                                          MaxHeight="320"
                                          IsItemClickEnabled="True"
                                          ItemClick="OnTagSuggestionItemClick"
                                          SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AvailableTagItem">
                                            <Grid ColumnSpacing="8"
                                                  Padding="4,2"
                                                  Margin="{x:Bind Indent}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0"
                                                          Glyph="{x:Bind TypeGlyph}"
                                                          FontSize="11"
                                                          VerticalAlignment="Center"
                                                          Opacity="0.7" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{x:Bind Name}"
                                                               FontSize="12" />
                                                    <TextBlock Text="{x:Bind SourceLabel}"
                                                               FontSize="10"
                                                               Opacity="0.6" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Tag="{x:Bind}"
                                                        Click="OnToggleAlbumTagSelectionClick"
                                                        Padding="4,2"
                                                        Visibility="{x:Bind PinVisibility}"
                                                        ToolTipService.ToolTip="Pin/unpin in album catalog">
                                                    <FontIcon Glyph="{x:Bind PinGlyph}"
                                                              FontSize="11" />
                                                </Button>
                                                <Button Grid.Column="3"
                                                        Tag="{x:Bind}"
                                                        Click="OnManageCatalogItemClick"
                                                        Padding="4,2"
                                                        ToolTipService.ToolTip="Spravovat tag">
                                                    <FontIcon Glyph="&#xE70F;"
                                                              FontSize="11" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Date taken — compact inline editor matching Photo Gallery -->
                    <StackPanel x:Name="DateEditPanel" Spacing="2" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel x:Name="DateAbsoluteMode" Spacing="2">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Date taken:"
                                           Style="{StaticResource InfoLabelStyle}"
                                           Width="Auto" />
                                <TextBox x:Name="DateTakenBox" Grid.Column="1"
                                         PlaceholderText="M/d/yyyy h:mm tt"
                                         FontSize="13"
                                         VerticalAlignment="Center"
                                         LostFocus="OnDateTakenBoxLostFocus"
                                         KeyDown="OnDateTakenBoxKeyDown" />
                                <Button Grid.Column="2" x:Name="DatePickerBtn"
                                        Padding="6,4"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Pick from calendar">
                                    <FontIcon Glyph="&#xE787;" FontSize="12" />
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel Spacing="8" Width="280">
                                                <CalendarDatePicker x:Name="DatePopupCal"
                                                                    PlaceholderText="Choose date"
                                                                    HorizontalAlignment="Stretch" />
                                                <TimePicker x:Name="DatePopupTime"
                                                            ClockIdentifier="12HourClock"
                                                            HorizontalAlignment="Stretch" />
                                                <Button Content="Apply"
                                                        Click="OnApplyDatePopupClick"
                                                        HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="DateMixedHint" Visibility="Collapsed"
                                       Text="Multiple dates — typing here sets all selected to the same date"
                                       FontStyle="Italic" FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="86,0,0,0"
                                       Foreground="{ThemeResource SystemAccentColorLight2}" />
                            <TextBlock x:Name="DateMultiHint" Visibility="Collapsed"
                                       Text="Editing applies to all selected images"
                                       FontStyle="Italic" FontSize="11"
                                       Margin="86,0,0,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DateParseError" Visibility="Collapsed"
                                       Text="Couldn't parse — try format like M/d/yyyy h:mm tt"
                                       FontSize="11"
                                       Margin="86,0,0,0"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <HyperlinkButton x:Name="SwitchToShiftBtn"
                                             Content="Shift by an offset…"
                                             Visibility="Collapsed"
                                             Click="OnSwitchToShift"
                                             Margin="80,0,0,0"
                                             Padding="6,0" FontSize="12" />
                        </StackPanel>
                        <StackPanel x:Name="DateShiftMode" Spacing="4" Visibility="Collapsed">
                            <TextBlock x:Name="ShiftHeaderText"
                                       Text="Shift each capture date by:"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Days" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <NumberBox x:Name="ShiftDaysBox" Value="0"
                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="1" LargeChange="7"
                                               ValueChanged="OnShiftValueChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Hours" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <NumberBox x:Name="ShiftHoursBox" Value="0"
                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="1" LargeChange="6"
                                               ValueChanged="OnShiftValueChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Min" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <NumberBox x:Name="ShiftMinutesBox" Value="0"
                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="1" LargeChange="15"
                                               ValueChanged="OnShiftValueChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Sec" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <NumberBox x:Name="ShiftSecondsBox" Value="0"
                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="1" LargeChange="30"
                                               ValueChanged="OnShiftValueChanged" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="ShiftPreviewText"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Click="OnApplyShiftClick"
                                        x:Name="ApplyShiftButton"
                                        Content="Apply shift" HorizontalAlignment="Stretch" />
                                <HyperlinkButton Grid.Column="1" Click="OnSwitchToAbsolute"
                                                 Content="Cancel"
                                                 FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- ═══ Row 1: Spacer (pushes info to bottom when viewport is tall) ═══ -->

                <!-- ═══ Row 2: Information block ═══ -->
                <StackPanel Grid.Row="2" Spacing="0">
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8,0,8" />
                    <TextBlock Text="Information" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />

                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Filename:" Style="{StaticResource InfoLabelStyle}" />
                            <TextBlock Grid.Column="1" x:Name="InfoFileName" Style="{StaticResource InfoValueStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind InfoFileName.Text, Mode=OneWay}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Folder:" Style="{StaticResource InfoLabelStyle}" />
                            <TextBlock Grid.Column="1" x:Name="InfoFolder" Style="{StaticResource InfoValueStyle}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind InfoFolder.Text, Mode=OneWay}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Size:" Style="{StaticResource InfoLabelStyle}" />
                            <TextBlock Grid.Column="1" x:Name="InfoFileSize" Style="{StaticResource InfoValueStyle}" />
                        </Grid>
                        <Grid Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Rating:" Style="{StaticResource InfoLabelStyle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" x:Name="StarPanel">
                                <Button x:Name="Star1" Tag="1" Click="OnStarClick" Style="{StaticResource DateTimePickerFlyoutButtonStyle}" Padding="2">
                                    <FontIcon x:Name="Star1Icon" Glyph="&#xE1CE;" FontSize="16" />
                                </Button>
                                <Button x:Name="Star2" Tag="2" Click="OnStarClick" Style="{StaticResource DateTimePickerFlyoutButtonStyle}" Padding="2">
                                    <FontIcon x:Name="Star2Icon" Glyph="&#xE1CE;" FontSize="16" />
                                </Button>
                                <Button x:Name="Star3" Tag="3" Click="OnStarClick" Style="{StaticResource DateTimePickerFlyoutButtonStyle}" Padding="2">
                                    <FontIcon x:Name="Star3Icon" Glyph="&#xE1CE;" FontSize="16" />
                                </Button>
                                <Button x:Name="Star4" Tag="4" Click="OnStarClick" Style="{StaticResource DateTimePickerFlyoutButtonStyle}" Padding="2">
                                    <FontIcon x:Name="Star4Icon" Glyph="&#xE1CE;" FontSize="16" />
                                </Button>
                                <Button x:Name="Star5" Tag="5" Click="OnStarClick" Style="{StaticResource DateTimePickerFlyoutButtonStyle}" Padding="2">
                                    <FontIcon x:Name="Star5Icon" Glyph="&#xE1CE;" FontSize="16" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Grid Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Flag:" Style="{StaticResource InfoLabelStyle}" />
                            <Button Grid.Column="1" x:Name="FlagButton" Click="OnFlagClick"
                                    Style="{StaticResource DateTimePickerFlyoutButtonStyle}"
                                    Padding="4,2" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="FlagIcon" Glyph="&#xE129;" FontSize="16" />
                                    <TextBlock x:Name="FlagText" Text="Not flagged" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid x:Name="InfoDimensionsRow">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Dimensions:" Style="{StaticResource InfoLabelStyle}" />
                            <TextBlock Grid.Column="1" x:Name="InfoDimensions" Style="{StaticResource InfoValueStyle}" />
                        </Grid>
                        <Grid x:Name="InfoCameraRow">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Camera:" Style="{StaticResource InfoLabelStyle}" />
                            <TextBlock Grid.Column="1" x:Name="InfoCamera" Style="{StaticResource InfoValueStyle}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Author:" Style="{StaticResource InfoLabelStyle}" />
                            <TextBlock Grid.Column="1" x:Name="InfoAuthor" Style="{StaticResource InfoValueStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Grid x:Name="InfoExposureRow">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Exposure:" Style="{StaticResource InfoLabelStyle}" />
                            <TextBlock Grid.Column="1" x:Name="InfoExposure" Style="{StaticResource InfoValueStyle}" />
                        </Grid>
                        <Grid x:Name="InfoApertureRow">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Aperture:" Style="{StaticResource InfoLabelStyle}" />
                            <TextBlock Grid.Column="1" x:Name="InfoAperture" Style="{StaticResource InfoValueStyle}" />
                        </Grid>
                        <Grid x:Name="InfoFocalLengthRow">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Focal length:" Style="{StaticResource InfoLabelStyle}" />
                            <TextBlock Grid.Column="1" x:Name="InfoFocalLength" Style="{StaticResource InfoValueStyle}" />
                        </Grid>
                        <Grid x:Name="InfoIsoRow">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ISO:" Style="{StaticResource InfoLabelStyle}" />
                            <TextBlock Grid.Column="1" x:Name="InfoIso" Style="{StaticResource InfoValueStyle}" />
                        </Grid>
                        <Grid x:Name="InfoLatRow" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Latitude:" Style="{StaticResource InfoLabelStyle}" />
                            <TextBlock Grid.Column="1" x:Name="InfoLatitude" Style="{StaticResource InfoValueStyle}" />
                        </Grid>
                        <Grid x:Name="InfoLonRow" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Longitude:" Style="{StaticResource InfoLabelStyle}" />
                            <TextBlock Grid.Column="1" x:Name="InfoLongitude" Style="{StaticResource InfoValueStyle}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Path:" Style="{StaticResource InfoLabelStyle}"
                                       VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" x:Name="InfoFilePath" Style="{StaticResource InfoValueStyle}"
                                       FontSize="11" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
