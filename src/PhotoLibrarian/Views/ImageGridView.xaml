<UserControl
    x:Class="PhotoLibrarian.Views.ImageGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:PhotoLibrarian.Controls">

    <UserControl.Resources>
        <!-- Force scroll bar to always be visible and opaque -->
        <Style x:Key="AlwaysVisibleScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Background" Value="{StaticResource HiTechPanelBackgroundBrush}" />
        </Style>
        
        <x:Double x:Key="ScrollBarSize">18</x:Double>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0"
              Padding="10,6"
              Background="{StaticResource HiTechPanelBackgroundAltBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="5"
                    VerticalAlignment="Bottom"
                    Height="1"
                    Background="{StaticResource HiTechAccentMutedBrush}"
                    IsHitTestVisible="False" />

            <!-- Sort controls -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="SORT"
                           VerticalAlignment="Center"
                           Margin="4,0"
                           Style="{StaticResource HiTechPanelHeadingStyle}" />
                <ComboBox x:Name="SortByCombo"
                          SelectedIndex="0"
                          MinWidth="140" Height="34"
                          Style="{StaticResource HiTechComboStyle}"
                          SelectionChanged="OnSortByChanged">
                    <ComboBoxItem Content="File Name" Tag="FileName" />
                    <ComboBoxItem Content="Date Taken" Tag="DateTaken" />
                    <ComboBoxItem Content="Date Modified" Tag="DateModified" />
                    <ComboBoxItem Content="File Size" Tag="FileSize" />
                </ComboBox>
                <Button x:Name="SortOrderBtn" Click="OnToggleSortOrder"
                        Width="34" Height="34" Padding="0"
                        ToolTipService.ToolTip="Toggle sort order"
                        AutomationProperties.Name="Toggle sort direction"
                        Style="{StaticResource HiTechRailButtonStyle}">
                    <FontIcon x:Name="SortOrderIcon" Glyph="&#xE014;" FontSize="16" />
                </Button>
            </StackPanel>

            <!-- Central FUI identity block -->
            <StackPanel Grid.Column="1" Grid.ColumnSpan="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="1">
                <TextBlock Text="VISUAL INDEX"
                           HorizontalAlignment="Center"
                           Style="{StaticResource HiTechPanelHeadingStyle}" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="6">
                    <TextBlock x:Name="VisiblePhotoCountText"
                               Text="0 PHOTOS"
                               Style="{StaticResource HiTechSystemCaptionStyle}"
                               Foreground="{StaticResource HiTechAccentBrush}" />
                    <Rectangle Width="32"
                               Height="1"
                               Fill="{StaticResource HiTechAccentMutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="LIVE"
                               Foreground="{StaticResource HiTechAccentBrush}"
                               Style="{StaticResource HiTechSystemCaptionStyle}" />
                </StackPanel>
            </StackPanel>

            <Path Grid.Column="2"
                  Data="M 0,0 L 16,0 L 24,8 L 58,8"
                  Stroke="{StaticResource HiTechAccentMutedBrush}"
                  StrokeThickness="1"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="14,0,0,2"
                  IsHitTestVisible="False" />
            <Path Grid.Column="2"
                  Data="M 0,8 L 34,8 L 42,0 L 58,0"
                  Stroke="{StaticResource HiTechAccentMutedBrush}"
                  StrokeThickness="1"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,2,14,0"
                  IsHitTestVisible="False" />

            <!-- File-name search. Tag filtering remains in the left tag tree. -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBox x:Name="SearchFileNameBox" Width="190" Height="34"
                         AutomationProperties.AutomationId="GalleryFileSearch"
                         PlaceholderText="Find filename..."
                         KeyDown="OnSearchKeyDown"
                         Style="{StaticResource HiTechInputStyle}"/>
                <Button Click="OnSearchClick" Height="34" Padding="10,0"
                        AutomationProperties.AutomationId="GallerySearchApply"
                        AutomationProperties.Name="Search photo filenames"
                        ToolTipService.ToolTip="Search filenames (Enter)"
                        Style="{StaticResource HiTechRailButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE721;" FontSize="16"/>
                        <TextBlock Text="SEARCH" FontFamily="Consolas" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OnSearchClear" Width="34" Height="34" Padding="0"
                        ToolTipService.ToolTip="Clear filename search"
                        AutomationProperties.AutomationId="GallerySearchClear"
                        AutomationProperties.Name="Clear filename search"
                        Style="{StaticResource HiTechRailButtonStyle}">
                    <FontIcon Glyph="&#xE711;" FontSize="16"/>
                </Button>
            </StackPanel>

            <!-- Thumbnail size slider -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Click="OnDecreaseSize" Width="34" Height="34" Padding="0"
                        ToolTipService.ToolTip="Smaller thumbnails"
                        AutomationProperties.Name="Smaller thumbnails"
                        Style="{StaticResource HiTechRailButtonStyle}">
                    <FontIcon Glyph="&#xE71F;" FontSize="16" />
                </Button>
                <Slider x:Name="SizeSlider" Width="112" Minimum="100" Maximum="400" Value="180"
                        VerticalAlignment="Center" ValueChanged="OnSizeSliderChanged" />
                <Button Click="OnIncreaseSize" Width="34" Height="34" Padding="0"
                        ToolTipService.ToolTip="Larger thumbnails"
                        AutomationProperties.Name="Larger thumbnails"
                        Style="{StaticResource HiTechRailButtonStyle}">
                    <FontIcon Glyph="&#xE8A3;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Custom Virtualizing Photo Grid -->
        <Grid Grid.Row="1">
            <local:VirtualizingPhotoGrid x:Name="PhotoGrid"
                                         RightTapped="OnGridBackgroundRightTapped" />
            <StackPanel HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="6,10,0,0"
                        Spacing="6"
                        IsHitTestVisible="False"
                        Opacity="0.55">
                <Rectangle Width="18" Height="2"
                           Fill="{StaticResource HiTechAccentBrush}" />
                <Rectangle Width="8" Height="1"
                           Fill="{StaticResource HiTechAccentMutedBrush}" />
                <Rectangle Width="14" Height="1"
                           Fill="{StaticResource HiTechAccentMutedBrush}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,8,8"
                        Spacing="4"
                        IsHitTestVisible="False"
                        Opacity="0.45">
                <TextBlock Text="IDX"
                           HorizontalAlignment="Right"
                           Style="{StaticResource HiTechSystemCaptionStyle}" />
                <Rectangle Width="38" Height="1"
                           Fill="{StaticResource HiTechAccentMutedBrush}" />
            </StackPanel>
        </Grid>

        <!-- Cinematic empty / indexing state -->
        <Grid x:Name="EmptyState"
              Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RightTapped="OnGridBackgroundRightTapped"
              Width="520"
              Height="260">
            <Border Background="#E60A121A"
                    BorderBrush="{StaticResource HiTechBorderStrongBrush}"
                    BorderThickness="1">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="VISUAL FEED"
                                   Style="{StaticResource HiTechPanelHeadingStyle}" />
                        <Rectangle Grid.Column="1"
                                   Height="1"
                                   Margin="12,0"
                                   Fill="{StaticResource HiTechAccentMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="IDX // 00"
                                   Style="{StaticResource HiTechSystemCaptionStyle}" />
                    </Grid>

                    <Grid Grid.Row="1"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="70" Height="70">
                            <Ellipse Stroke="{StaticResource HiTechBorderStrongBrush}"
                                     StrokeThickness="1" />
                            <Ellipse Width="50"
                                     Height="50"
                                     Stroke="{StaticResource HiTechAccentMutedBrush}"
                                     StrokeThickness="1"
                                     StrokeDashArray="3,3" />
                            <Line X1="35" Y1="6"
                                  X2="35" Y2="64"
                                  Stroke="{StaticResource HiTechAccentMutedBrush}"
                                  StrokeThickness="1" />
                            <Line X1="6" Y1="35"
                                  X2="64" Y2="35"
                                  Stroke="{StaticResource HiTechAccentMutedBrush}"
                                  StrokeThickness="1" />
                            <ProgressRing x:Name="EmptyStateProgress"
                                          Width="34"
                                          Height="34"
                                          IsActive="False"
                                          Foreground="{StaticResource HiTechAccentBrush}" />
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="5">
                            <TextBlock x:Name="EmptyStateTitle"
                                       Text="ARCHIVE EMPTY"
                                       FontFamily="Consolas"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="80"
                                       Foreground="{StaticResource HiTechTextPrimaryBrush}" />
                            <TextBlock x:Name="EmptyStateSubtitle"
                                       Text="Awaiting visual assets. Add or select a library folder."
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       Foreground="{StaticResource HiTechTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,6,0,0">
                                <Rectangle Width="36"
                                           Height="2"
                                           Fill="{StaticResource HiTechAccentBrush}" />
                                <Rectangle Width="18"
                                           Height="2"
                                           Fill="{StaticResource HiTechAccentMutedBrush}" />
                                <Rectangle Width="8"
                                           Height="2"
                                           Fill="{StaticResource HiTechAccentMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <TextBlock x:Name="EmptyStateCode"
                                   Text="STATE / STANDBY"
                                   Style="{StaticResource HiTechSystemCaptionStyle}" />
                        <TextBlock Text="LOCAL ARCHIVE"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource HiTechSystemCaptionStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <Path Data="M 0,34 L 0,0 L 70,0"
                  Stroke="{StaticResource HiTechAccentBrush}"
                  StrokeThickness="2"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="-6" />
            <Path Data="M 0,34 L 0,0 L 70,0"
                  Stroke="{StaticResource HiTechAccentBrush}"
                  StrokeThickness="2"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="-6"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <RotateTransform Angle="180" />
                </Path.RenderTransform>
            </Path>
        </Grid>
    </Grid>
</UserControl>
