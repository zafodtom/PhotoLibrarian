<UserControl
    x:Class="PhotoLibrarian.Views.ImageGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:PhotoLibrarian.Controls">

    <UserControl.Resources>
        <!-- Force scroll bar to always be visible and opaque -->
        <Style x:Key="AlwaysVisibleScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        </Style>
        
        <x:Double x:Key="ScrollBarSize">18</x:Double>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Padding="8,4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Group By controls -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Group:" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="GroupByCombo" 
                          SelectedIndex="0" 
                          MinWidth="140"
                          SelectionChanged="OnGroupByChanged">
                    <ComboBoxItem Content="None" Tag="None" />
                    <ComboBoxItem Content="File Type" Tag="FileType" />
                    <ComboBoxItem Content="Media Type" Tag="MediaType" />
                    <ComboBoxItem Content="Year Taken" Tag="YearTaken" Visibility="Collapsed" />
                    <ComboBoxItem Content="Month Taken" Tag="MonthTaken" Visibility="Collapsed" />
                    <ComboBoxItem Content="File Size" Tag="FileSize" />
                    <ComboBoxItem Content="Image Size" Tag="ImageSize" />
                    <ComboBoxItem Content="Rating" Tag="Rating" Visibility="Collapsed" />
                    <ComboBoxItem Content="Camera" Tag="Camera" />
                </ComboBox>
            </StackPanel>

            <!-- Sort controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
                <TextBlock Text="Sort:" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="SortByCombo" 
                          SelectedIndex="1" 
                          MinWidth="120"
                          SelectionChanged="OnSortByChanged">
                    <ComboBoxItem Content="File Name" Tag="FileName" />
                    <ComboBoxItem Content="Date Taken" Tag="DateTaken" />
                    <ComboBoxItem Content="Date Modified" Tag="DateModified" />
                    <ComboBoxItem Content="File Size" Tag="FileSize" />
                    <ComboBoxItem Content="Rating" Tag="Rating" Visibility="Collapsed" />
                </ComboBox>
                <Button x:Name="SortOrderBtn" Click="OnToggleSortOrder" Padding="6" ToolTipService.ToolTip="Toggle sort order">
                    <FontIcon x:Name="SortOrderIcon" Glyph="&#xE014;" FontSize="12" />
                </Button>
            </StackPanel>

            <!-- Refinement filters -->
            <Button x:Name="FilterButton"
                    AutomationProperties.AutomationId="GridFilterButton"
                    AutomationProperties.Name="Refine photos"
                    Grid.Column="3"
                    Margin="0,0,12,0"
                    ToolTipService.ToolTip="Refine the current left-pane results">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71C;" FontSize="16" />
                    <TextBlock Text="Filter" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout x:Name="FilterFlyout">
                        <ScrollViewer MaxHeight="640"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel MinWidth="384" Spacing="16">
                                <TextBlock Text="Refine results"
                                           Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="These filters narrow the union selected in the left pane."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />

                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Rating"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Visibility="Collapsed" />
                                    <ComboBox x:Name="RatingCombo"
                                              Visibility="Collapsed"
                                              AutomationProperties.AutomationId="FilterRating"
                                              AutomationProperties.Name="Rating"
                                              Grid.Column="1"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Any" Tag="" />
                                        <ComboBoxItem Content="1 star" Tag="1" />
                                        <ComboBoxItem Content="2 stars" Tag="2" />
                                        <ComboBoxItem Content="3 stars" Tag="3" />
                                        <ComboBoxItem Content="4 stars" Tag="4" />
                                        <ComboBoxItem Content="5 stars" Tag="5" />
                                    </ComboBox>
                                    <ComboBox x:Name="RatingModeCombo"
                                              Visibility="Collapsed"
                                              AutomationProperties.AutomationId="FilterRatingMode"
                                              AutomationProperties.Name="Rating comparison"
                                              Grid.Column="2"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="and higher" Tag="AndHigher" />
                                        <ComboBoxItem Content="exactly" Tag="Exact" />
                                        <ComboBoxItem Content="and lower" Tag="AndLower" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="1"
                                               Visibility="Collapsed"
                                               Text="Capture date"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <ComboBox x:Name="DatePresetCombo"
                                              Visibility="Collapsed"
                                              AutomationProperties.AutomationId="FilterDatePreset"
                                              AutomationProperties.Name="Capture date range"
                                              Grid.Row="1"
                                              Grid.Column="1"
                                              Grid.ColumnSpan="2"
                                              SelectedIndex="0"
                                              SelectionChanged="OnDatePresetChanged">
                                        <ComboBoxItem Content="Any date" Tag="Any" />
                                        <ComboBoxItem Content="This year" Tag="ThisYear" />
                                        <ComboBoxItem Content="Last 12 months" Tag="Last12Months" />
                                        <ComboBoxItem Content="Custom range" Tag="Custom" />
                                    </ComboBox>
                                </Grid>

                                <Grid x:Name="CustomDatePanel"
                                      AutomationProperties.Name="Custom capture date range"
                                      ColumnSpacing="8"
                                      Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CalendarDatePicker x:Name="DateFromPicker"
                                                        AutomationProperties.AutomationId="FilterDateFrom"
                                                        AutomationProperties.Name="Capture date from"
                                                        PlaceholderText="From" />
                                    <CalendarDatePicker x:Name="DateToPicker"
                                                        AutomationProperties.AutomationId="FilterDateTo"
                                                        AutomationProperties.Name="Capture date to"
                                                        Grid.Column="1"
                                                        PlaceholderText="To" />
                                </Grid>

                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Include tags"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBox x:Name="IncludeTagsBox"
                                             AutomationProperties.AutomationId="FilterIncludeTags"
                                             AutomationProperties.Name="Tags to include"
                                             Grid.Column="1"
                                             PlaceholderText="Comma-separated; all must match" />

                                    <TextBlock Grid.Row="1"
                                               Text="Exclude tags"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBox x:Name="ExcludeTagsBox"
                                             AutomationProperties.AutomationId="FilterExcludeTags"
                                             AutomationProperties.Name="Tags to exclude"
                                             Grid.Row="1"
                                             Grid.Column="1"
                                             PlaceholderText="Comma-separated" />

                                    <TextBlock Grid.Row="2"
                                               Visibility="Collapsed"
                                               Text="Person"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <ComboBox x:Name="PersonCombo"
                                              Visibility="Collapsed"
                                              AutomationProperties.AutomationId="FilterPerson"
                                              AutomationProperties.Name="Person"
                                              Grid.Row="2"
                                              Grid.Column="1"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Anyone" Tag="" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="3"
                                               Visibility="Collapsed"
                                               Text="Flag"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <ComboBox x:Name="FlagCombo"
                                              Visibility="Collapsed"
                                              AutomationProperties.AutomationId="FilterFlag"
                                              AutomationProperties.Name="Flag state"
                                              Grid.Row="3"
                                              Grid.Column="1"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Any" Tag="Any" />
                                        <ComboBoxItem Content="Flagged only" Tag="Flagged" />
                                        <ComboBoxItem Content="Unflagged only" Tag="Unflagged" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="4"
                                               Text="Media"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <StackPanel Grid.Row="4"
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                        <ComboBox x:Name="MediaKindCombo"
                                                  AutomationProperties.AutomationId="FilterMediaKind"
                                                  AutomationProperties.Name="Media kind"
                                                  MinWidth="128"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="All media" Tag="Any" />
                                            <ComboBoxItem Content="Photos" Tag="Photos" />
                                            <ComboBoxItem Content="Videos" Tag="Videos" />
                                        </ComboBox>
                                        <TextBox x:Name="ExtensionsBox"
                                                 AutomationProperties.AutomationId="FilterExtensions"
                                                 AutomationProperties.Name="File extensions"
                                                 MinWidth="144"
                                                 PlaceholderText="JPG, RAW, MP4" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="5"
                                               Text="Missing"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <ComboBox x:Name="MissingMetadataCombo"
                                              AutomationProperties.AutomationId="FilterMissingMetadata"
                                              AutomationProperties.Name="Missing metadata"
                                              Grid.Row="5"
                                              Grid.Column="1"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Any metadata" Tag="None" />
                                        <ComboBoxItem Content="Untagged" Tag="Tags" />
                                        <ComboBoxItem Content="Unrated" Tag="Rating" Visibility="Collapsed" />
                                        <ComboBoxItem Content="No capture date" Tag="CaptureDate" Visibility="Collapsed" />
                                        <ComboBoxItem Content="No geotag" Tag="Geotag" Visibility="Collapsed" />
                                    </ComboBox>
                                </Grid>

                                <StackPanel HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <Button AutomationProperties.AutomationId="FilterClearAll"
                                            Click="OnClearAllFilters"
                                            Content="Clear all" />
                                    <Button AutomationProperties.AutomationId="FilterApply"
                                            Click="OnApplyFilters"
                                            Content="Apply"
                                            Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- Thumbnail size slider -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                <Button Click="OnDecreaseSize" Padding="6" ToolTipService.ToolTip="Smaller thumbnails">
                    <FontIcon Glyph="&#xE71F;" FontSize="12" />
                </Button>
                <Slider x:Name="SizeSlider" Width="120" Minimum="100" Maximum="400" Value="180"
                        VerticalAlignment="Center" ValueChanged="OnSizeSliderChanged" />
                <Button Click="OnIncreaseSize" Padding="6" ToolTipService.ToolTip="Larger thumbnails">
                    <FontIcon Glyph="&#xE8A3;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="ActiveFiltersScroller"
                      Grid.Row="1"
                      Padding="8,4"
                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                      HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollMode="Disabled"
                      Visibility="Collapsed">
            <StackPanel x:Name="ActiveFiltersPanel"
                        Orientation="Horizontal"
                        Spacing="8" />
        </ScrollViewer>

        <!-- Custom Virtualizing Photo Grid -->
        <local:VirtualizingPhotoGrid x:Name="PhotoGrid"
                                     Grid.Row="2"
                                     RightTapped="OnGridBackgroundRightTapped" />

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" Grid.Row="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    RightTapped="OnGridBackgroundRightTapped"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    Spacing="8">
            <FontIcon Glyph="&#xEB9F;" FontSize="48"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      HorizontalAlignment="Center" />
            <TextBlock Text="No photos yet"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Click + in the Library panel to add a folder"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
