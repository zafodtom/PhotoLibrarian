<Window
    x:Class="PhotoLibrarian.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhotoLibrarian.Views"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Title="PhotoLibrarian">

    <Grid x:Name="AppRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top ribbon (shown when viewer is open) -->
        <views:TopRibbon x:Name="TopRibbon" Grid.Row="0" Visibility="Collapsed" />

        <!-- Main 3-panel layout -->
        <Grid x:Name="MainLayout" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPanelColumn" Width="280" MinWidth="200" />
                <ColumnDefinition x:Name="LeftSplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="CenterColumn" Width="*" />
                <ColumnDefinition x:Name="RightSplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="RightPanelColumn" Width="300" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- Left: Folder Navigation -->
            <views:FolderNavigationPanel x:Name="FolderNavPanel" Grid.Column="0" />

            <!-- Resizable splitter -->
            <controls:GridSplitter x:Name="LeftPanelSplitter"
                                   Grid.Column="1" 
                                   Width="12"
                                   ResizeBehavior="BasedOnAlignment"
                                   ResizeDirection="Auto"
                                   Background="Transparent"
                                   HorizontalAlignment="Stretch" />

            <!-- Center: Image Grid with Viewer Overlay -->
            <Grid Grid.Column="2">
                <views:ImageGridView x:Name="ImageGridPanel" />
                
                <!-- Overlay: Image Viewer (only over grid area) -->
                <views:ImageViewerOverlay x:Name="ViewerOverlay" 
                                           Visibility="Collapsed" />
            </Grid>

            <!-- Resizable splitter -->
            <controls:GridSplitter x:Name="RightPanelSplitter"
                                   Grid.Column="3" 
                                   Width="12"
                                   ResizeBehavior="BasedOnAlignment"
                                   ResizeDirection="Auto"
                                   Background="Transparent"
                                   HorizontalAlignment="Stretch" />

            <!-- Right: Metadata Panel -->
            <views:MetadataPanel x:Name="MetadataDetailPanel" Grid.Column="4" />
        </Grid>

        <!-- Start screen shown when no album was supplied. -->
        <Grid x:Name="AlbumStartOverlay"
              Grid.Row="1"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
              Visibility="Collapsed">
            <StackPanel Width="420"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                <TextBlock Text="PhotoLibrarian"
                           FontSize="32"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Choose an existing album folder or a regular photo folder. If it is not an album yet, PhotoLibrarian will create one automatically."
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="Open / create album"
                        Click="OnOpenAlbumClick"
                        HorizontalAlignment="Stretch"
                        Padding="16,10"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Overlay: Image Editor -->
        <views:ImageEditorView x:Name="EditorOverlay" Grid.Row="0" Grid.RowSpan="2"
                                Visibility="Collapsed" />

        <!-- Overlay: Settings Panel -->
        <Border x:Name="SettingsOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    MaxWidth="760"
                    Margin="24"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Center">
                <views:SettingsPanel x:Name="SettingsPanel" />
            </Border>
        </Border>

        <Border x:Name="PeopleReviewOverlay"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                Visibility="Collapsed">
            <views:PeopleReviewView />
        </Border>

        <!-- Status bar -->
        <Grid x:Name="StatusBar"
              Grid.Row="2" Padding="12,6"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusBarText" 
                       Text="Ready"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center" />
            <ProgressRing x:Name="IndexingProgress" 
                          Grid.Column="1"
                          IsActive="False"
                          Width="16" Height="16" 
                          Margin="0,0,8,0" />
            <Button x:Name="SettingsButton" 
                    AutomationProperties.AutomationId="SettingsButton"
                    AutomationProperties.Name="Settings"
                    Grid.Column="5"
                    Click="OnSettingsClick"
                    Padding="8,4"
                    ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
            <Button x:Name="BenchmarkButton" Visibility="Collapsed" 
                    AutomationProperties.AutomationId="BenchmarkButton"
                    AutomationProperties.Name="Run benchmark"
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    Click="OnBenchmarkClick"
                    Padding="8,4"
                    ToolTipService.ToolTip="Run Benchmark">
                <FontIcon Glyph="&#xE9D9;" FontSize="14" />
            </Button>
            <Button x:Name="FaceDetectionButton"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="FaceDetectionButton"
                    AutomationProperties.Name="Stop face detection"
                    Grid.Column="3"
                    Margin="0,0,8,0"
                    Padding="8,4"
                    Command="{x:Bind ViewModel.ToggleFaceDetectionCommand}"
                    ToolTipService.ToolTip="Stop face detection">
                <FontIcon x:Name="FaceDetectionIcon" Glyph="&#xE769;" FontSize="14" />
            </Button>
            <Button x:Name="PeopleReviewButton"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="PeopleReviewButton"
                    AutomationProperties.Name="Review people suggestions"
                    Grid.Column="4"
                    Margin="0,0,8,0"
                    Click="OnPeopleReviewClick"
                    Padding="8,4"
                    ToolTipService.ToolTip="Review people suggestions">
                <FontIcon Glyph="&#xE716;" FontSize="14" />
            </Button>
        </Grid>
    </Grid>
</Window>
