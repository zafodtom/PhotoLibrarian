<Window
    x:Class="PhotoLibrarian.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhotoLibrarian.Views"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Title="PhotoLibrarian">

    <Grid x:Name="AppRoot"
          RequestedTheme="Dark"
          Background="{StaticResource HiTechAppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top ribbon (shown when viewer is open) -->
        <views:TopRibbon x:Name="TopRibbon" Grid.Row="0" Visibility="Collapsed" />

        <!-- Main 3-panel layout -->
        <Grid x:Name="MainLayout" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPanelColumn" Width="280" MinWidth="200" />
                <ColumnDefinition x:Name="LeftSplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="CenterColumn" Width="*" />
                <ColumnDefinition x:Name="RightSplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="RightPanelColumn" Width="300" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- Left: Folder Navigation -->
            <Border Grid.Column="0"
                    Margin="8,8,0,8"
                    Style="{StaticResource HiTechPanelStyle}">
                <views:FolderNavigationPanel x:Name="FolderNavPanel" />
            </Border>

            <!-- Resizable splitter -->
            <controls:GridSplitter x:Name="LeftPanelSplitter"
                                   Grid.Column="1" 
                                   Width="12"
                                   ResizeBehavior="BasedOnAlignment"
                                   ResizeDirection="Auto"
                                   Background="Transparent"
                                   HorizontalAlignment="Stretch" />

            <!-- Center: Image Grid with Viewer Overlay -->
            <Border Grid.Column="2"
                    Margin="0,8,0,8"
                    Style="{StaticResource HiTechPanelAltStyle}">
                <Grid>
                    <views:ImageGridView x:Name="ImageGridPanel" />

                    <!-- Overlay: Image Viewer (only over grid area) -->
                    <views:ImageViewerOverlay x:Name="ViewerOverlay"
                                              Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Resizable splitter -->
            <controls:GridSplitter x:Name="RightPanelSplitter"
                                   Grid.Column="3" 
                                   Width="12"
                                   ResizeBehavior="BasedOnAlignment"
                                   ResizeDirection="Auto"
                                   Background="Transparent"
                                   HorizontalAlignment="Stretch" />

            <!-- Right: Metadata Panel -->
            <Border Grid.Column="4"
                    Margin="0,8,8,8"
                    Style="{StaticResource HiTechPanelStyle}">
                <views:MetadataPanel x:Name="MetadataDetailPanel" />
            </Border>
        </Grid>

        <!-- Start screen shown when no album was supplied. -->
        <Grid x:Name="AlbumStartOverlay"
              Grid.Row="1"
              Background="{StaticResource HiTechAppBackgroundBrush}"
              Visibility="Collapsed">
            <StackPanel Width="420"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                <TextBlock Text="PHOTOLIBRARIAN"
                           FontSize="30"
                           HorizontalAlignment="Center"
                           Style="{StaticResource HiTechTitleStyle}" />
                <TextBlock Text="Choose an existing album folder or a regular photo folder. If it is not an album yet, PhotoLibrarian will create one automatically."
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{StaticResource HiTechTextSecondaryBrush}" />
                <Button Content="Open / create album"
                        Click="OnOpenAlbumClick"
                        HorizontalAlignment="Stretch"
                        Padding="16,10"
                        Style="{StaticResource HiTechPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Overlay: Image Editor -->
        <views:ImageEditorView x:Name="EditorOverlay" Grid.Row="0" Grid.RowSpan="2"
                                Visibility="Collapsed" />

        <!-- Overlay: Settings Panel -->
        <Border x:Name="SettingsOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                Background="{StaticResource HiTechAppBackgroundBrush}">
            <Border Style="{StaticResource HiTechPanelAltStyle}"
                    MaxWidth="760"
                    Margin="24"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Center">
                <views:SettingsPanel x:Name="SettingsPanel" />
            </Border>
        </Border>

        <!-- Status bar -->
        <Grid x:Name="StatusBar"
              Grid.Row="2"
              Padding="12,6"
              Background="{StaticResource HiTechPanelBackgroundAltBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusBarText"
                       Text="Ready"
                       Style="{StaticResource HiTechCaptionStyle}"
                       VerticalAlignment="Center" />

            <ProgressRing x:Name="IndexingProgress"
                          Grid.Column="1"
                          IsActive="False"
                          Width="16"
                          Height="16"
                          Margin="0,0,8,0" />

            <Button x:Name="SettingsButton"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="SettingsButton"
                    AutomationProperties.Name="Settings"
                    Click="OnSettingsClick"
                    Padding="8,4"
                    ToolTipService.ToolTip="Settings"
                    Style="{StaticResource HiTechIconButtonStyle}">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
        </Grid>
    </Grid>
</Window>
