<Window
    x:Class="PhotoLibrarian.BootWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PhotoLibrarian">

    <Grid x:Name="Root"
          RequestedTheme="Dark"
          Background="#070B10">
        <Border Margin="18"
                Background="#0A121A"
                BorderBrush="#34738A"
                BorderThickness="1">
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Width="4"
                               Fill="#53D7E8" />
                    <StackPanel Grid.Column="1"
                                Margin="14,0,0,0">
                        <TextBlock Text="PHOTO // LIBRARIAN"
                                   FontFamily="Consolas"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="120"
                                   Foreground="#E6F7FA" />
                        <TextBlock Text="VISUAL ARCHIVE BOOT SEQUENCE"
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   CharacterSpacing="170"
                                   Foreground="#34738A" />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Right">
                        <TextBlock Text="NODE"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   FontSize="9"
                                   CharacterSpacing="140"
                                   Foreground="#34738A" />
                        <TextBlock Text="LOCAL"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="#53D7E8" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1"
                      VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="AlertText"
                               Text=""
                               Visibility="Collapsed"
                               FontFamily="Consolas"
                               FontSize="10"
                               FontWeight="SemiBold"
                               CharacterSpacing="160"
                               Foreground="#FF5A64"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4" />

                    <TextBlock x:Name="PhaseCodeText"
                               Grid.Row="1"
                               Text="BOOT // 01"
                               FontFamily="Consolas"
                               FontSize="10"
                               CharacterSpacing="160"
                               Foreground="#34738A"
                               HorizontalAlignment="Center" />

                    <TextBlock x:Name="StatusText"
                               Grid.Row="2"
                               Text="INITIALIZING ARCHIVE"
                               Margin="0,8,0,0"
                               FontFamily="Consolas"
                               FontSize="18"
                               FontWeight="SemiBold"
                               CharacterSpacing="70"
                               Foreground="#E6F7FA"
                               HorizontalAlignment="Center" />

                    <StackPanel Grid.Row="3"
                                Margin="60,22,60,0"
                                Spacing="6">
                        <Grid Height="12">
                            <Border BorderBrush="#244252"
                                    BorderThickness="1"
                                    Background="#071018" />
                            <ProgressBar x:Name="BootProgress"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="5"
                                         Height="8"
                                         Margin="2"
                                         Foreground="#53D7E8"
                                         Background="Transparent" />
                        </Grid>
                        <Grid>
                            <TextBlock x:Name="DetailText"
                                       Text="Resolving local album context..."
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       Foreground="#8CA9B3" />
                            <TextBlock x:Name="PercentText"
                                       Text="005%"
                                       HorizontalAlignment="Right"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       Foreground="#53D7E8" />
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="4"
                          Margin="60,22,60,0">
                        <Path Data="M 0,14 L 0,0 L 62,0"
                              Stroke="#53D7E8"
                              StrokeThickness="2"
                              HorizontalAlignment="Left" />
                        <Path Data="M 0,14 L 0,0 L 62,0"
                              Stroke="#34738A"
                              StrokeThickness="2"
                              HorizontalAlignment="Right"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="180" />
                            </Path.RenderTransform>
                        </Path>
                        <TextBlock Text="CACHE / DATABASE / INDEX / UI"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas"
                                   FontSize="9"
                                   CharacterSpacing="120"
                                   Foreground="#34738A" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="2">
                    <Rectangle Height="1"
                               Fill="#244252"
                               VerticalAlignment="Top" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,10,0,0"
                                Spacing="12">
                        <TextBlock Text="SYS"
                                   FontFamily="Consolas"
                                   FontSize="9"
                                   Foreground="#53D7E8" />
                        <TextBlock Text="LOCAL-FIRST"
                                   FontFamily="Consolas"
                                   FontSize="9"
                                   Foreground="#8CA9B3" />
                        <TextBlock Text="PORTABLE ALBUM MODE"
                                   FontFamily="Consolas"
                                   FontSize="9"
                                   Foreground="#8CA9B3" />
                    </StackPanel>
                </Grid>

                <Path Data="M 0,32 L 0,0 L 64,0"
                      Stroke="#53D7E8"
                      StrokeThickness="2"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="-12" />
                <Path Data="M 0,32 L 0,0 L 64,0"
                      Stroke="#53D7E8"
                      StrokeThickness="2"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="-12"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform Angle="180" />
                    </Path.RenderTransform>
                </Path>
            </Grid>
        </Border>
    </Grid>
</Window>