<UserControl
    x:Class="PhotoLibrarian.Controls.CinematicProgressBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root"
    Foreground="#65D5E5"
    IsTabStop="False"
    AutomationProperties.Name="Operation progress">
    <!-- Identical 12px frame, inset and luminous progress strip to the boot screen. -->
    <Grid Height="12"
          MinWidth="24">
        <Border BorderBrush="#2C5061"
                BorderThickness="1"
                Background="#0B151F" />
        <ProgressBar x:Name="InnerProgress"
                     Minimum="0"
                     Maximum="100"
                     Value="0"
                     Height="8"
                     Margin="2"
                     Foreground="{Binding Foreground, ElementName=Root}"
                     Background="Transparent" />
    </Grid>
</UserControl>
