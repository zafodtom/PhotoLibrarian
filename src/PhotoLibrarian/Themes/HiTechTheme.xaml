<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PhotoLibrarian Hi-Tech / FUI theme -->
    <SolidColorBrush x:Key="HiTechAppBackgroundBrush" Color="#070C12" />
    <SolidColorBrush x:Key="HiTechPanelBackgroundBrush" Color="#0B151F" />
    <SolidColorBrush x:Key="HiTechPanelBackgroundAltBrush" Color="#112230" />
    <SolidColorBrush x:Key="HiTechPanelHoverBrush" Color="#193447" />
    <SolidColorBrush x:Key="HiTechBorderBrush" Color="#2C5061" />
    <SolidColorBrush x:Key="HiTechBorderStrongBrush" Color="#42859A" />
    <SolidColorBrush x:Key="HiTechAccentBrush" Color="#65D5E5" />
    <SolidColorBrush x:Key="HiTechAccentMutedBrush" Color="#397887" />
    <SolidColorBrush x:Key="HiTechAccentFillBrush" Color="#153842" />
    <SolidColorBrush x:Key="HiTechTextPrimaryBrush" Color="#E8F5F7" />
    <SolidColorBrush x:Key="HiTechTextSecondaryBrush" Color="#9AB7C2" />
    <SolidColorBrush x:Key="HiTechDangerBrush" Color="#FF737B" />

    <CornerRadius x:Key="HiTechPanelCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="HiTechControlCornerRadius">2</CornerRadius>

    <Style x:Key="HiTechPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HiTechPanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HiTechBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource HiTechPanelCornerRadius}" />
    </Style>

    <Style x:Key="HiTechPanelAltStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HiTechPanelBackgroundAltBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HiTechBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource HiTechPanelCornerRadius}" />
    </Style>

    <Style x:Key="HiTechSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HiTechAccentBrush}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="100" />
    </Style>

    <Style x:Key="HiTechTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HiTechTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
    </Style>

    <Style x:Key="HiTechCaptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HiTechTextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="HiTechIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource HiTechPanelBackgroundAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource HiTechTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HiTechBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource HiTechControlCornerRadius}" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <!-- Cinematic UI 2.0: industrial, flat side-rail controls.
         Inherit normal WinUI pointer, pressed, focus and disabled behavior.
         No new dimensions, transitions or layout changes. -->
    <Style x:Key="HiTechRailButtonStyle" TargetType="Button"
           BasedOn="{StaticResource HiTechIconButtonStyle}">
        <Setter Property="Background" Value="{StaticResource HiTechPanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HiTechAccentMutedBrush}" />
        <Setter Property="BorderThickness" Value="0,0,2,0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- A destructive action stays recognizable without repainting other tools. -->
    <Style x:Key="HiTechRailDangerButtonStyle" TargetType="Button"
           BasedOn="{StaticResource HiTechRailButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource HiTechDangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HiTechDangerBrush}" />
    </Style>

    <Style x:Key="HiTechPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource HiTechAccentFillBrush}" />
        <Setter Property="Foreground" Value="{StaticResource HiTechTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HiTechAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource HiTechControlCornerRadius}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,9" />
    </Style>

    <Style x:Key="HiTechTreeViewStyle" TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource HiTechTextPrimaryBrush}" />
    </Style>

    <Style x:Key="HiTechModuleStyle" TargetType="Border">
        <Setter Property="Background" Value="#A60A1118" />
        <Setter Property="BorderBrush" Value="{StaticResource HiTechBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="HiTechInputStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#C90A121A" />
        <Setter Property="Foreground" Value="{StaticResource HiTechTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HiTechBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="SelectionHighlightColor" Value="{StaticResource HiTechAccentMutedBrush}" />
    </Style>

    <Style x:Key="HiTechComboStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="#C90A121A" />
        <Setter Property="Foreground" Value="{StaticResource HiTechTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HiTechBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="FontFamily" Value="Consolas" />
    </Style>

    <Style x:Key="HiTechTinyLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HiTechAccentMutedBrush}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="CharacterSpacing" Value="160" />
    </Style>

    <!-- Visual phase: section labels carry one consistent industrial accent.
         These styles are presentation only; no control templates or handlers. -->
    <Style x:Key="HiTechPanelHeadingStyle" TargetType="TextBlock"
           BasedOn="{StaticResource HiTechSectionHeaderStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="130" />
        <Setter Property="Foreground" Value="{StaticResource HiTechAccentBrush}" />
    </Style>

    <Style x:Key="HiTechSystemCaptionStyle" TargetType="TextBlock"
           BasedOn="{StaticResource HiTechTinyLabelStyle}">
        <Setter Property="Foreground" Value="{StaticResource HiTechTextSecondaryBrush}" />
        <Setter Property="CharacterSpacing" Value="110" />
    </Style>

</ResourceDictionary>
