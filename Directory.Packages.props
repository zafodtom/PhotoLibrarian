<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Windows App SDK / WinUI 3 -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <!-- MVVM & UI Toolkit -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.ImageCropper" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <!-- GPU Rendering -->
    <PackageVersion Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <!-- Image Metadata -->
    <PackageVersion Include="MetadataExtractor" Version="2.9.3" />
    <PackageVersion Include="XmpCore" Version="6.1.10.1" />
    <PackageVersion Include="PhotoSauce.MagicScaler" Version="0.15.0" />
    <PackageVersion Include="PhotoSauce.NativeCodecs.Libheif" Version="1.23.5-preview1" />
    <!-- SQLite -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- ML / ONNX -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
  </ItemGroup>
</Project>